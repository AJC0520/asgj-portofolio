---
// Site header, shared by every page (rendered in Layout.astro).
// It keeps its place during page changes (view-transition-name: site-header).

// `id`: the section (on the home page, an element with this id) or page the item stands for.
// The navigation indicator underlines the current one and points from it to the one you hover.
// `copy`: clicking copies this to the clipboard instead (with a small "copied" note); the href is the fallback.
const EMAIL = 'asgeirjacobsen@gmail.com';
const links: { id: string; label: string; href: string; copy?: string }[] = [
	{ id: 'projects', label: 'Projects', href: '/#projects' },
	{ id: 'about', label: 'About', href: '/#about' },
	{ id: 'contact', label: 'Contact', href: `mailto:${EMAIL}`, copy: EMAIL },
];

// A profile without an href (yet) is a button that shows `wip` in a note under it instead
const LINKEDIN = 'https://www.linkedin.com/in/asgeirjacobsen/';
const profiles: { label: string; href?: string; path: string; wip?: { title: string; before: string; link: string; after: string } }[] = [
	{
		label: 'GitHub',
		href: 'https://github.com/ajc0520/',
		path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
	},
	{
		label: 'LinkedIn',
		href: LINKEDIN,
		path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 4.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
	},
	{
		label: 'CV',
		href: undefined,
		wip: { title: 'CV: work in progress', before: 'Check out my ', link: 'LinkedIn', after: ' for now' },
		// Page with a folded corner and two text lines cut out
		path: 'M4 1h11l6 6v16H4zM14.5 2.5V7.5h5zM7.5 12h9v1.75h-9zM7.5 16h9v1.75h-9z',
	},
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = current === '/';
---

<header class="site-header">
	{
		// Home: on the home page it scrolls back up to the hero; elsewhere it goes home (with the sweep)
		isHome ? (
			<a class="mark" href="#hero" aria-label="Home" data-nav="hero">
				AJ.
			</a>
		) : (
			<a class="mark" href="/" aria-label="Home" data-nav="hero" data-home>
				AJ.
			</a>
		)
	}
	<div class="right">
		<nav aria-label="Main">
			{
				links.map((link) => (
					<a href={link.href} data-nav={link.id} data-copy={link.copy}>
						{link.label}
					</a>
				))
			}
		</nav>
		<span class="divider" aria-hidden="true"></span>
		<ul class="profiles">
			{
				profiles.map((profile) => (
					<li>
						{profile.href ? (
							<a
								href={profile.href}
								aria-label={profile.label}
								target="_blank"
								rel="noopener noreferrer"
								title={profile.label}
								data-profile={profile.label.toLowerCase()}
							>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d={profile.path} fill-rule="evenodd" />
								</svg>
							</a>
						) : (
							<button
								type="button"
								aria-label={`${profile.label} (work in progress)`}
								title={profile.label}
								data-profile={profile.label.toLowerCase()}
								data-wip={JSON.stringify({ ...profile.wip, href: LINKEDIN })}
							>
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d={profile.path} fill-rule="evenodd" />
								</svg>
							</button>
						)}
					</li>
				))
			}
		</ul>
	</div>

	<!-- A small note that drops in under an item after a click: "Email copied", "CV: work in progress"
	     (filled in and placed by the script) -->
	<p class="toast" data-toast role="status" aria-live="polite">
		<span class="toast-inner" data-toast-inner hidden>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path data-toast-icon></path></svg>
			<span class="toast-text">
				<b data-toast-title></b>
				<span data-toast-body></span>
			</span>
		</span>
	</p>

	<!-- Navigation indicator: an underline under the current item that becomes an arrow to the hovered one -->
	<svg class="nav-indicator" aria-hidden="true">
		<path class="shaft"></path>
		<path class="head"></path>
	</svg>
</header>

<style>
	.site-header {
		--cream: #f4efe1;
		--yellow: #e9c85b;

		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 16px;
		color: var(--cream);
		font-family: var(--font-inter-tight);
		font-weight: 600;
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		view-transition-name: site-header;
		/* Set from the section underneath (data-header-color), so scrolling content never shows through */
		background: var(--header-bg, transparent);
	}

	/* A section with its own text colour: links, the mark and the navigation indicator all follow it */
	.site-header[data-ink] {
		--yellow: var(--header-ink);
		--cream: var(--header-ink);
	}

	/* Same grain as the section underneath (see data-header-grain), so the header blends into it */
	.site-header[data-grain]::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: var(--grain);
		opacity: 0.028; /* matches the hero's visible grain, which sits partly under the map's top fade */
		pointer-events: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.mark {
		font-size: 18px;
		letter-spacing: -0.02em;
		color: var(--yellow);
	}

	a.mark {
		transition: opacity 150ms ease;
	}

	a.mark:focus-visible {
		outline: 2px solid var(--yellow);
		outline-offset: 4px;
	}

	.right {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		align-items: center;
		gap: 12px 28px;
	}

	nav {
		display: flex;
		gap: 28px;
	}

	nav a {
		transition: color 150ms ease;
	}

	nav a[aria-current] {
		color: var(--yellow);
	}

	.nav-indicator {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
		fill: none;
		stroke: var(--yellow);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}


	@media (hover: hover) {
		nav a:hover {
			color: var(--yellow);
		}
	}

	.divider {
		width: 1px;
		height: 14px;
		background: rgba(244, 239, 225, 0.25);
	}

	.profiles {
		display: flex;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.profiles a,
	.profiles button {
		display: block;
		transition: color 150ms ease;
	}

	.profiles button {
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	.profiles svg {
		display: block;
		width: 18px;
		height: 18px;
		fill: currentColor;
	}

	@media (hover: hover) {
		.profiles a[href]:hover,
		.profiles button:hover {
			color: var(--yellow);
		}
	}

	.profiles a:focus-visible,
	.profiles button:focus-visible,
	nav a:focus-visible {
		outline: 2px solid var(--yellow);
		outline-offset: 4px;
	}

	/* ——— The note under an item ——— */

	.toast {
		position: absolute;
		top: 0;
		left: 0;
		margin: 0;
		pointer-events: none;
	}

	.toast-inner {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 9px 14px 9px 11px;
		border-radius: 12px;
		background: var(--yellow);
		color: #04151f;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0;
		text-transform: none;
		white-space: nowrap;
		box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.45);
		transform-origin: top center;
		pointer-events: auto; /* it can hold a link */
	}

	.toast-inner[hidden] {
		display: none;
	}

	/* In: drops down a little and settles. Out: fades up and away. */
	.toast-inner[data-state='in'] {
		animation: toast-in 320ms cubic-bezier(0.165, 0.84, 0.44, 1) both;
	}

	.toast-inner[data-state='out'] {
		animation: toast-out 220ms ease-in both;
	}

	@keyframes toast-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.92);
		}
	}

	@keyframes toast-out {
		to {
			opacity: 0;
			transform: translateY(-6px) scale(0.96);
		}
	}

	.toast-inner svg {
		flex: none;
		width: 18px;
		height: 18px;
		padding: 3px;
		border-radius: 50%;
		background: #04151f;
		fill: none;
		stroke: var(--yellow);
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* The icon draws itself once the note has landed */
	.toast-inner[data-state='in'] path {
		stroke-dasharray: 16;
		animation: draw-icon 360ms cubic-bezier(0.165, 0.84, 0.44, 1) 160ms both;
	}

	@keyframes draw-icon {
		from {
			stroke-dashoffset: 16;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	.toast-text {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}

	.toast-text b {
		font-weight: 700;
	}

	.toast-text span {
		opacity: 0.8;
	}

	/* The link is made by the script, so it has no scope attribute: :global */
	.toast-text :global(a) {
		color: inherit;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.toast-text :global(a:focus-visible) {
		outline: 2px solid #04151f;
		outline-offset: 2px;
		border-radius: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.toast-inner[data-state],
		.toast-inner[data-state] path {
			animation: none;
		}
	}

	@media (max-width: 640px) {
		nav {
			gap: 16px;
		}

		.right {
			column-gap: 16px;
		}

		/* Icons wrap onto their own row under the links; the divider would dangle */
		.divider {
			display: none;
		}
	}
</style>

<script>
	import { clearSweeps, navigateAfterSweep, sweep } from '../scripts/sweep';

	// The header takes the colour of whichever section is under it (sections opt in with data-header-color)
	const header = document.querySelector<HTMLElement>('.site-header')!;
	const coloured = [...document.querySelectorAll<HTMLElement>('[data-header-color]')];
	if (coloured.length) {
		let queued = false;
		const tint = () => {
			queued = false;
			const probe = header.offsetHeight / 2;
			const under = coloured.find((section) => {
				const rect = section.getBoundingClientRect();
				return rect.top <= probe && rect.bottom > probe;
			});
			header.style.setProperty('--header-bg', under?.dataset.headerColor ?? 'transparent');
			// Sections with a surface texture (data-header-grain) get it on the header too, so the two match
			header.toggleAttribute('data-grain', under?.hasAttribute('data-header-grain') ?? false);
			// Sections can also set the header's text colour (data-header-ink), e.g. on a light background
			const ink = under?.dataset.headerInk;
			header.toggleAttribute('data-ink', !!ink);
			if (ink) header.style.setProperty('--header-ink', ink);
		};
		addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(tint);
			},
			{ passive: true },
		);
		addEventListener('resize', tint);
		tint();
	}

	// ——— Navigation indicator ———
	// At rest: an underline under the current item. Hover (or focus) another item and it becomes a bracket
	// arrow: down from under the current item, across, and up into an arrowhead under the hovered one.
	// The underline is the same path with its corners at zero depth, so the arrow grows straight out of it.
	// Each frame every value moves a fixed share of the way to where it should be (like the cursor blob), so
	// it's interruptible: sweep across the items and it redirects mid-flight instead of restarting.
	const FOLLOW = 14; // higher = snappier
	const HEAD = 5; // arrowhead half-width (px)
	const DROP = 10; // how far the arrow dips below the underline (px)
	const RADIUS = 6; // rounding of the arrow's two bends (px)
	const GAP = 7; // space between the text and the line (px)

	const indicator = header.querySelector<SVGSVGElement>('.nav-indicator')!;
	const shaft = indicator.querySelector<SVGPathElement>('.shaft')!;
	const head = indicator.querySelector<SVGPathElement>('.head')!;
	const items = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
	const instant = matchMedia('(prefers-reduced-motion: reduce)').matches;

	let current: HTMLAnchorElement | undefined;
	let hovered: HTMLAnchorElement | undefined;
	const shown = { x1: 0, x2: 0, head: 0 };
	let target = { ...shown };
	let lineY = 0;
	let running = false;
	let last = 0;
	let placed = false;

	// Where the current section/page is: sections on this page (by scroll position), otherwise the address
	function findCurrent() {
		const onPage = items.filter((item) => document.getElementById(item.dataset.nav!));
		if (onPage.length) {
			const probe = innerHeight * 0.4;
			const top = (item: HTMLElement) => document.getElementById(item.dataset.nav!)!.getBoundingClientRect().top;
			// The section whose top has most recently passed the probe line (page order, not nav order)
			const passed = onPage.filter((item) => top(item) <= probe).sort((a, b) => top(b) - top(a));
			return passed[0] ?? onPage.sort((a, b) => top(a) - top(b))[0];
		}
		const path = location.pathname.replace(/\/$/, '') || '/';
		return items.find((item) => new URL(item.href).pathname.replace(/\/$/, '') === path && item.getAttribute('href') !== '#');
	}

	function box(item: HTMLElement) {
		const rect = item.getBoundingClientRect();
		const origin = header.getBoundingClientRect();
		return { left: rect.left - origin.left, right: rect.right - origin.left, center: rect.left - origin.left + rect.width / 2 };
	}

	function retarget() {
		if (!current) {
			target = { x1: shown.x1, x2: shown.x1, head: 0 };
		} else if (hovered && hovered !== current) {
			const from = box(current);
			const to = box(hovered);
			target = { x1: from.center, x2: to.center, head: 1 };
		} else {
			const at = box(current);
			target = { x1: at.left, x2: at.right, head: 0 };
		}
		if (!placed || instant) {
			Object.assign(shown, target);
			placed = true;
		}
		if (!running) {
			running = true;
			last = performance.now();
			requestAnimationFrame(frame);
		}
	}

	function draw() {
		const { x1, x2 } = shown;
		const depth = DROP * shown.head; // how far the bends have sunk (0 at rest: a flat underline)
		const bottom = lineY + depth;
		const dir = Math.sign(x2 - x1) || 1;
		// Rounded bends, never bigger than the dip or half the width
		const r = Math.min(RADIUS, depth, Math.abs(x2 - x1) / 2);
		const size = HEAD * shown.head; // the chevron grows in with the arrow
		const tip = lineY - 1;
		// Down from the current item, around the bend, across, around, and up into the chevron's tip
		shaft.setAttribute(
			'd',
			`M${x1} ${lineY}L${x1} ${bottom - r}Q${x1} ${bottom} ${x1 + dir * r} ${bottom}` +
				`L${x2 - dir * r} ${bottom}Q${x2} ${bottom} ${x2} ${bottom - r}L${x2} ${size > 0.2 ? tip : lineY}`,
		);
		// Open chevron, same weight as the line
		head.setAttribute('d', size > 0.2 ? `M${x2 - size} ${tip + size * 1.2}L${x2} ${tip}L${x2 + size} ${tip + size * 1.2}` : '');
	}

	function frame(now: number) {
		const dt = Math.min(0.05, (now - last) / 1000);
		last = now;
		const k = 1 - Math.exp(-FOLLOW * dt);
		let moving = false;
		for (const key of ['x1', 'x2', 'head'] as const) {
			shown[key] += (target[key] - shown[key]) * k;
			if (Math.abs(target[key] - shown[key]) > 0.05) moving = true;
			else shown[key] = target[key];
		}
		draw();
		if (moving) requestAnimationFrame(frame);
		else running = false;
	}

	function measure() {
		// One shared baseline just under the lowest item, so the line runs straight across the header
		const origin = header.getBoundingClientRect();
		lineY = Math.max(...items.map((item) => item.getBoundingClientRect().bottom - origin.top)) + GAP;
	}

	function updateCurrent() {
		const next = findCurrent();
		if (next === current) return;
		current?.removeAttribute('aria-current');
		current = next;
		// On the home page these are sections ("location"); on their own pages they're pages
		current?.setAttribute('aria-current', document.getElementById(current.dataset.nav!) ? 'location' : 'page');
		retarget();
	}

	// Moving from one item to the next crosses a gap where nothing is hovered. Wait a moment before folding
	// back, so going from e.g. About to Contact just slides the arrowhead over instead of redrawing the arrow.
	const LEAVE_GRACE = 150;
	let leaveTimer = 0;
	const enter = (item: HTMLAnchorElement) => {
		clearTimeout(leaveTimer);
		if (hovered === item) return;
		hovered = item;
		retarget();
	};
	const leave = (item: HTMLAnchorElement) => {
		clearTimeout(leaveTimer);
		leaveTimer = window.setTimeout(() => {
			if (hovered !== item) return;
			hovered = undefined;
			retarget();
		}, LEAVE_GRACE);
	};
	for (const item of items) {
		item.addEventListener('pointerenter', () => enter(item));
		item.addEventListener('pointerleave', () => leave(item));
		item.addEventListener('focus', () => enter(item));
		item.addEventListener('blur', () => leave(item));
	}

	let navQueued = false;
	addEventListener(
		'scroll',
		() => {
			if (navQueued) return;
			navQueued = true;
			requestAnimationFrame(() => {
				navQueued = false;
				updateCurrent();
			});
		},
		{ passive: true },
	);
	new ResizeObserver(() => {
		measure();
		placed = false; // jump to the new layout instead of animating across it
		retarget();
	}).observe(header);
	document.fonts.ready.then(() => {
		measure();
		placed = false;
		retarget();
	});
	measure();
	updateCurrent();

	// ——— Notes under items ———
	// Contact copies the email and says so; the CV (not ready yet) says it's a work in progress.
	// The note stays while the pointer is on it, so its link can be clicked.
	const ICONS = {
		tick: 'M3 8.5l3.2 3L13 4.5',
		clock: 'M8 3.8V8.2l2.8 1.8', // clock hands: "in progress"
	};
	const toast = header.querySelector<HTMLElement>('[data-toast]')!;
	const toastInner = toast.querySelector<HTMLElement>('[data-toast-inner]')!;
	let hideTimer = 0;
	let showFor = 0;

	function hideSoon(ms: number) {
		clearTimeout(hideTimer);
		hideTimer = window.setTimeout(() => {
			toastInner.dataset.state = 'out';
			hideTimer = window.setTimeout(() => (toastInner.hidden = true), instant ? 0 : 220);
		}, ms);
	}

	function showToast(item: HTMLElement, note: { icon: keyof typeof ICONS; title: string; body: (string | Node)[] }, ms: number) {
		toastInner.querySelector('[data-toast-icon]')!.setAttribute('d', ICONS[note.icon]);
		toastInner.querySelector('[data-toast-title]')!.textContent = note.title;
		toastInner.querySelector('[data-toast-body]')!.replaceChildren(...note.body);
		toastInner.hidden = false;
		// Restart the drop-in, even if it's already showing
		toastInner.removeAttribute('data-state');
		void toastInner.offsetWidth;
		toastInner.dataset.state = 'in';
		// Under the item, centred on it, but never past the header's edges
		const at = box(item);
		const below = item.getBoundingClientRect().bottom - header.getBoundingClientRect().top;
		const width = toastInner.offsetWidth;
		const left = Math.max(16, Math.min(at.center - width / 2, header.clientWidth - width - 16));
		toast.style.transform = `translate(${left}px, ${Math.max(lineY, below) + 12}px)`;
		showFor = ms;
		hideSoon(ms);
	}

	toastInner.addEventListener('pointerenter', () => clearTimeout(hideTimer));
	toastInner.addEventListener('pointerleave', () => hideSoon(Math.min(showFor, 1500)));

	for (const link of header.querySelectorAll<HTMLAnchorElement>('[data-copy]')) {
		link.addEventListener('click', async (e) => {
			// If the clipboard isn't available (or refuses), the link does its normal thing: a new email
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || !navigator.clipboard) return;
			e.preventDefault();
			const value = link.dataset.copy!;
			try {
				await navigator.clipboard.writeText(value);
				showToast(link, { icon: 'tick', title: 'Email copied', body: [value] }, 2400);
			} catch {
				location.href = link.href;
			}
		});
	}

	for (const button of header.querySelectorAll<HTMLButtonElement>('[data-wip]')) {
		const wip = JSON.parse(button.dataset.wip!);
		button.addEventListener('click', () => {
			const link = Object.assign(document.createElement('a'), { href: wip.href, target: '_blank', rel: 'noopener noreferrer', textContent: wip.link });
			showToast(button, { icon: 'clock', title: wip.title, body: [wip.before, link, wip.after] }, 4000);
		});
	}

	// Going home: the hero's dark sweeps in from the "AJ." corner, then the hero loads
	// (and its name plays its intro again — a natural "welcome back").
	const HERO_COLOR = getComputedStyle(document.documentElement).getPropertyValue('--color-hero').trim() || '#04151f';

	const home = document.querySelector<HTMLAnchorElement>('[data-home]');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (home && !reduceMotion) {
		let leaving = false;

		home.addEventListener('click', async (e) => {
			// New tab / window: plain navigation
			if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || leaving) return;
			e.preventDefault();
			leaving = true;
			// From the top-left corner (where the logo is) toward the opposite corner
			await sweep({ color: HERO_COLOR, angle: Math.atan2(innerHeight, innerWidth) });
			navigateAfterSweep(home.href);
		});

		// Coming back with the browser's back button can restore this page mid-transition: clean up
		window.addEventListener('pageshow', (e) => {
			if (!e.persisted) return;
			leaving = false;
			clearSweeps();
		});
	}
</script>
