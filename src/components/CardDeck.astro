---
// Two stacked "cards": on scroll the back one is pulled out from under the front one and put in front of it
---

<div class="deck">
	<div class="stage">
		<div class="card back">
			<slot name="back" />
		</div>
		<div class="card front">
			<slot name="front" />
			<div class="dim"></div>
		</div>
	</div>
</div>

<style>
	.deck {
		/* 100vh of stage + the rest is scroll distance that drives the move */
		height: 150dvh;
	}

	.stage {
		position: sticky;
		top: 0;
		height: 100dvh;
		overflow: hidden;
		background: #f4efe1;
	}

	.card {
		position: absolute;
		inset: 0;
		overflow: hidden;
		transform-origin: 50% 50%;
		will-change: transform;
	}

	.back {
		z-index: 1;
	}

	.front {
		z-index: 2;
		background: #141416;
	}

	.stage[data-flipped] .back {
		z-index: 3;
		/* Separates the front card from the one peeking out behind it */
		box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.18);
	}

	.dim {
		position: absolute;
		inset: 0;
		background: #000;
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.deck {
			height: auto;
			display: flex;
			flex-direction: column-reverse;
		}

		.stage {
			display: contents;
		}

		.card {
			position: relative;
			will-change: auto;
		}
	}
</style>

<script>
	// --ease-in-out-cubic: surfaces already on screen, moving like physical objects
	const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
	const clamp = (t: number) => Math.min(1, Math.max(0, t));
	const progress = (p: number, from: number, to: number) => clamp((p - from) / (to - from));
	const phase = (p: number, from: number, to: number) => easeInOutCubic(progress(p, from, to));

	const REST_SCALE = 0.86; // size of a card "in the hand"
	const BACK_SCALE = 0.82; // slightly smaller while behind: reads as further away
	// How far (% of card height) the back card drops: just enough to clear the front card's bottom edge,
	// so the swap to the front happens while the two don't overlap and can't be seen
	const DROP = 86;
	const RADIUS = 28;
	// Once covered, the hero stays visible as the next card in the deck
	const PUSH_BACK = 0.04; // how much smaller it gets when it moves one card back
	const PEEK = 5; // how much of it shows above the front card (% of viewport height)
	// Offset that puts the hero's top edge PEEK above the front card's top edge
	const PEEK_OFFSET = (1 - REST_SCALE) * 50 - PEEK - (1 - (REST_SCALE - PUSH_BACK)) * 50;

	const deck = document.querySelector<HTMLElement>('.deck')!;
	const stage = deck.querySelector<HTMLElement>('.stage')!;
	const back = deck.querySelector<HTMLElement>('.back')!;
	const front = deck.querySelector<HTMLElement>('.front')!;
	const dim = deck.querySelector<HTMLElement>('.dim')!;

	function render() {
		const scrollable = deck.offsetHeight - window.innerHeight;
		const p = clamp(-deck.getBoundingClientRect().top / scrollable);

		const shrink = phase(p, 0, 0.35); // front card becomes a card in the hand
		const pullOut = phase(p, 0.1, 0.5); // back card slides down out from behind…
		const putFront = phase(p, 0.5, 1); // …then slides back up in front, coming slightly closer

		// Front (hero): shrinks into a card, then moves one card back in the deck,
		// its top edge peeking out above the new front card
		const frontScale = 1 - (1 - REST_SCALE) * shrink - PUSH_BACK * putFront;
		front.style.transform = `translateY(${PEEK_OFFSET * putFront}%) scale(${frontScale})`;
		front.style.borderRadius = `${RADIUS * shrink}px`;
		dim.style.opacity = `${0.25 * putFront}`;
		// Only its top edge shows once the other card has landed: lets its content (the name) pause
		front.toggleAttribute('data-covered', p >= 1);

		// Back card: moves in front at the bottom of its drop, where it no longer overlaps the hero
		const inFront = p >= 0.5;
		stage.toggleAttribute('data-flipped', inFront);
		const y = inFront ? DROP * (1 - putFront) : DROP * pullOut;
		const scale = inFront ? BACK_SCALE + (REST_SCALE - BACK_SCALE) * putFront : BACK_SCALE;
		back.style.transform = `translateY(${y}%) scale(${scale})`;
		back.style.borderRadius = `${RADIUS}px`;
	}

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let queued = false;
		const schedule = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				render();
			});
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		render();
	}
</script>
