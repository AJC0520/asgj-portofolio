---
// Two stacked "cards": the back one is pulled up from behind and folded over the front one on scroll
---

<div class="deck">
	<div class="stage">
		<div class="card back">
			<slot name="back" />
		</div>
		<div class="card front">
			<slot name="front" />
			<div class="dim"></div>
		</div>
	</div>
</div>

<style>
	.deck {
		/* 100vh of stage + 150vh of scroll to drive the fold */
		height: 150dvh;
	}

	.stage {
		position: sticky;
		top: 0;
		height: 100dvh;
		overflow: hidden;
		perspective: 1600px;
		perspective-origin: 50% 20%;
		background: #f4efe1;
	}

	.card {
		position: absolute;
		inset: 0;
		overflow: hidden;
		transform-origin: 50% 50%;
		backface-visibility: hidden;
		will-change: transform;
	}

	.back {
		z-index: 1;
	}

	.front {
		z-index: 2;
		background: #141416;
	}

	.stage[data-flipped] .back {
		z-index: 3;
	}

	.dim {
		position: absolute;
		inset: 0;
		background: #000;
		opacity: 0;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.deck {
			height: auto;
			display: flex;
			flex-direction: column-reverse;
		}

		.stage {
			display: contents;
		}

		.card {
			position: relative;
			will-change: auto;
		}
	}
</style>

<script>
	// --ease-in-out-cubic: surfaces already on screen, moving like physical objects
	const easeInOutCubic = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
	const clamp = (t: number) => Math.min(1, Math.max(0, t));
	// The flip is split in two halves around the edge-on swap: accelerate into it, decelerate out of it,
	// so the whole flip still reads as one ease-in-out-cubic with no stall in the middle
	const easeInCubic = (t: number) => t * t * t;
	const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
	const progress = (p: number, from: number, to: number) => clamp((p - from) / (to - from));
	const phase = (p: number, from: number, to: number) => easeInOutCubic(progress(p, from, to));

	const REST_SCALE = 0.86; // size of a card "in the hand"
	const LIFT = 40; // % of card height the back card rises before folding over
	const RADIUS = 28;

	const deck = document.querySelector<HTMLElement>('.deck')!;
	const stage = deck.querySelector<HTMLElement>('.stage')!;
	const back = deck.querySelector<HTMLElement>('.back')!;
	const front = deck.querySelector<HTMLElement>('.front')!;
	const dim = deck.querySelector<HTMLElement>('.dim')!;

	function render() {
		const scrollable = deck.offsetHeight - window.innerHeight;
		const p = clamp(-deck.getBoundingClientRect().top / scrollable);

		const shrink = phase(p, 0, 0.35); // front card becomes a card in the hand
		const lift = phase(p, 0.1, 0.5); // back card slides up from behind
		const tipOver = easeInCubic(progress(p, 0.25, 0.5)); // …and tips toward the viewer until edge-on
		const land = easeOutCubic(progress(p, 0.5, 1)); // then falls forward and lands in front

		// Front (hero): shrinks into a card, then gets pushed back and dimmed
		const frontScale = 1 - (1 - REST_SCALE) * shrink - 0.06 * land;
		front.style.transform = `scale(${frontScale})`;
		front.style.borderRadius = `${RADIUS * shrink}px`;
		dim.style.opacity = `${0.55 * land}`;

		// Back card: swaps in front of the hero exactly when it is edge-on (invisible)
		const flipped = p >= 0.5;
		stage.toggleAttribute('data-flipped', flipped);
		if (!flipped) {
			back.style.transform = `translateY(${-LIFT * lift}%) scale(${REST_SCALE}) rotateX(${-90 * tipOver}deg)`;
			back.style.borderRadius = `${RADIUS}px`;
		} else {
			back.style.transform = `translateY(${-LIFT * (1 - land)}%) scale(${REST_SCALE}) rotateX(${90 * (1 - land)}deg)`;
			back.style.borderRadius = `${RADIUS}px`;
		}
	}

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let queued = false;
		const schedule = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				render();
			});
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		render();
	}
</script>
