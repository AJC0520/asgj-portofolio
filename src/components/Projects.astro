---
// Projects: an index of rows (year, name, description, tags). Hovering a row wipes in the project's own colour;
// clicking it slides the list out to the left and the project's detail pane in from the right, in that colour.
// Each project has its own address (#projects/<slug>), so the browser's back button and shared links work.
//
// Each project's view is its own component in ./projects/ (its own layout and styling); this file provides the
// colours, the slide, the scroll lock and the "All projects" button. Projects without a component yet show a
// simple placeholder view.
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { logoFor, logos } from './projects/logos';
import KartTracker from './projects/KartTracker.astro';
import Olsalget from './projects/Olsalget.astro';
import ThisWebsite from './projects/ThisWebsite.astro';

type Project = {
	year: string;
	name: string;
	description: string;
	tags: string[];
	href?: string; // source code
	site?: string; // live version
	accent: string;
	onAccent: string;
	brand?: 'karttracker'; // the name in the list uses the project's own logo style
	vibe?: 'map' | 'race' | 'beer'; // the row's hover background (see "Row vibes" in the styles)
	slug?: string; // the address (#projects/<slug>); made from the name when not given
	component?: AstroComponentFactory;
};

const projects = ([
	{
		year: '2026',
		name: 'This website',
		description: 'My portfolio: a name made of characters, a map of Tromsø and probably too many animations.',
		tags: ['Astro', 'TypeScript', 'Canvas', 'SVG'],
		href: 'https://github.com/AJC0520/asgj-portofolio',
		accent: 'var(--color-camel)',
		onAccent: 'var(--color-charcoal-brown)',
		component: ThisWebsite,
		vibe: 'map',
	},
	{
		year: '2026',
		name: 'KartTracker',
		description:
			'A Mario Kart tournament tracker for me and my friends: leaderboards, player stats, race history and charts.',
		tags: ['Vue', 'TypeScript', 'Tailwind CSS', 'Pinia', 'Supabase', 'Vite'],
		href: 'https://github.com/AJC0520/karting',
		site: 'https://kartingmario.netlify.app/',
		accent: 'var(--color-dark-walnut)',
		onAccent: '#f4efe1',
		component: KartTracker,
		brand: 'karttracker',
		vibe: 'race',
	},
	{
		year: '2025',
		name: 'Når stenger ølsalget?',
		description:
			'Can I still buy beer? A live countdown to closing time in Norway that knows the rules for weekends and every public holiday.',
		tags: ['React', 'JavaScript', 'Vite', 'React Router'],
		href: 'https://github.com/AJC0520/naar-stenger-olsalget',
		site: 'https://xn--nrstengerlsalget-dob46a.no/',
		accent: '#f2ae2e', // the site's own beer amber
		onAccent: '#251c1c',
		component: Olsalget,
		vibe: 'beer',
		slug: 'olsalget',
	},
	{
		year: '2025',
		name: 'Project three',
		description: 'Short description of the project: what it does and what you learned making it.',
		tags: ['Tag', 'Tag', 'Tag'],
		href: undefined,
		accent: 'var(--color-dusty-olive)',
		onAccent: '#f4efe1',
	},
	{
		year: '2024',
		name: 'Project four',
		description: 'Short description of the project: what it does and what you learned making it.',
		tags: ['Tag'],
		href: undefined,
		accent: 'var(--color-dry-sage)',
		onAccent: 'var(--color-charcoal-brown)',
	},
] as Project[]).map((project) => ({
	...project,
	slug: project.slug ?? project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
}));
---

<section id="projects" data-header-color="var(--color-projects)">
	<div class="track">
		<!-- The list -->
		<div class="pane list-pane">
			<h2>Projects</h2>

			<ol class="projects">
				{
					projects.map((project) => (
						<li>
							<button
								class="row"
								type="button"
								data-open={project.slug}
								data-cursor="plain"
								data-vibe={project.vibe}
								style={`--accent: ${project.accent}; --on-accent: ${project.onAccent}`}
							>
								<span class="year">{project.year}</span>
								{project.brand === 'karttracker' ? (
									<span class="name brand-karttracker">
										<span class="visually-hidden">{project.name}</span>
										<span class="kart" aria-hidden="true">
											KART
										</span>
										<span class="tracker" aria-hidden="true">
											TRACKER
										</span>
									</span>
								) : (
									<span class="name">{project.name}</span>
								)}
								<span class="description">{project.description}</span>
								<span class="tags">
									{project.tags.map((tag) => {
										const logo = logoFor(tag);
										return (
											<span class="tag">
												{logo && (
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d={logos[logo]} />
													</svg>
												)}
												{tag}
											</span>
										);
									})}
								</span>
								<span class="arrow" aria-hidden="true">
									→
								</span>
							</button>
						</li>
					))
				}
			</ol>
		</div>

		<!-- One project at a time -->
		<div class="pane detail-pane" inert>
			{
				projects.map((project) => (
					<article
						class="detail"
						data-project={project.slug}
						data-accent={project.accent}
						data-on-accent={project.onAccent}
						style={`--accent: ${project.accent}; --on-accent: ${project.onAccent}`}
						hidden
					>
						<button class="back" type="button" data-close>
							<span aria-hidden="true">←</span> All projects
						</button>
						{project.component ? (
							<project.component href={project.href} project={project} />
						) : (
							<div class="generic">
								<p class="meta">
									{project.year} · {project.tags.join(' · ')}
								</p>
								<h3 data-detail-title tabindex="-1">
									{project.name}
								</h3>
								<p class="lead">{project.description}</p>
								<p class="placeholder">More about this project is coming soon.</p>
								{(project.site || project.href) && (
									<p class="links">
										{project.site && (
											<a class="link" href={project.site} target="_blank" rel="noopener">
												Visit the app <span aria-hidden="true">↗</span>
											</a>
										)}
										{project.href && (
											<a class="link" href={project.href} target="_blank" rel="noopener">
												View on GitHub <span aria-hidden="true">↗</span>
											</a>
										)}
									</p>
								)}
							</div>
						)}
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	#projects {
		--cream: #f4efe1;
		--ease-out-quart: cubic-bezier(0.165, 0.84, 0.44, 1);
		/* The list ↔ detail slide: a large surface moving on screen, so ease-in-out (speeds up, settles) */
		--ease-in-out-quart: cubic-bezier(0.77, 0, 0.175, 1);

		display: grid;
		min-height: 100dvh;
		background: var(--color-projects);
		color: var(--cream);
		font-family: var(--font-inter-tight);
		font-weight: 600;
		overflow-x: clip; /* the off-screen pane never widens the page */
	}

	/* Both panes side by side; the track slides one width to the left to show the detail.
	   Leaving the detail is a little quicker than entering it. */
	.track {
		display: grid;
		grid-template-columns: 100% 100%;
		transition: transform 520ms var(--ease-in-out-quart);
	}

	#projects[data-detail] .track {
		transform: translateX(-100%);
		transition-duration: 650ms;
	}

	.pane {
		box-sizing: border-box;
		min-height: 100dvh;
		padding: 88px 16px 64px; /* just below the fixed site header */
	}

	/* While a project is open the page is locked (see the script): the pane fills the screen and scrolls
	   on its own if its content gets long, without dragging the page along */
	#projects[data-detail] .detail-pane {
		max-height: 100dvh;
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: none; /* like the page: scrolls, no visible bar */
	}

	#projects[data-detail] .detail-pane::-webkit-scrollbar {
		display: none;
	}

	:global(html[data-scroll-lock]) {
		overflow: hidden;
	}

	.detail-pane {
		background: var(--accent, var(--color-projects));
		color: var(--on-accent, var(--cream));
		/* The back button's full-width strip must not spill into the list pane next to it */
		overflow-x: clip;
	}

	h2 {
		margin: 0 0 clamp(32px, 6vh, 64px);
		font-size: clamp(40px, 7vw, 112px);
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	/* ——— List ——— */

	/* One set of columns for the whole list (rows use subgrid), so they line up. The tags column is capped:
	   a long list of technologies wraps onto a second line instead of squeezing the descriptions */
	/* One set of columns for the whole list (rows use subgrid), so they line up. The tags column is capped:
	   a long list of technologies wraps onto a second line instead of squeezing the descriptions */
	.projects {
		display: grid;
		grid-template-columns: 64px minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 380px) 32px;
		column-gap: 24px;
		row-gap: 6px; /* the section's colour between the bands */
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.projects li {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
	}

	/* Every row is a band in its project's colour, with its own texture (data-vibe) always showing */
	.row {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: center; /* year, title, description and tags all centred in the row */
		width: 100%;
		padding: 22px 12px;
		border: 0;
		border-radius: 4px;
		background: var(--accent);
		color: var(--on-accent);
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	/* Hover light: a soft wash over the band */
	.row::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
		opacity: 0;
		transition: opacity 220ms ease;
	}

	/* ——— Row vibes: a texture on the band. On hover it comes alive (transform only: smooth) ——— */

	.row[data-vibe]::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -2;
		pointer-events: none;
		transition: transform 900ms var(--ease-out-quart);
	}

	/* This website: the hero's street map of Tromsø, faint, in the row's text colour. Hover: it zooms in */
	.row[data-vibe='map']::after {
		background: var(--on-accent);
		opacity: 0.2;
		mask: url('/tromso-map.svg') center 46% / 100% auto no-repeat;
	}

	/* KartTracker: a chequered flag fading in from the right, and the logo's gold-and-red stripe below.
	   Hover: the flag slides along like a moving track (the layer is one tile wider than the row for that) */
	.row[data-vibe='race']::after {
		right: -32px;
		background:
			linear-gradient(#f4a700, #f4a700) left bottom 3px / 100% 3px no-repeat,
			linear-gradient(#cc1100, #cc1100) left bottom / 100% 3px no-repeat,
			repeating-conic-gradient(rgba(244, 239, 225, 0.18) 0 25%, transparent 0 50%) right top / 16px 16px;
		mask:
			linear-gradient(#000, #000) left bottom / 100% 6px no-repeat,
			linear-gradient(to left, #000, transparent 45%);
	}

	/* Når stenger ølsalget?: a head of foam along the top of the band, and bubbles fading in from the right.
	   Hover: the bubbles rise (the layer is one tile taller than the row for that) */
	.row[data-vibe='beer'] {
		background:
			radial-gradient(circle at 50% 0, #fffaf0 8px, transparent 9px) left 6px / 20px 10px repeat-x,
			linear-gradient(#fffaf0, #fffaf0) top / 100% 7px no-repeat,
			var(--accent);
	}

	.row[data-vibe='beer']::after {
		bottom: -48px;
		background:
			radial-gradient(circle, rgba(255, 250, 240, 0.55) 2.5px, transparent 3px) 0 0 / 48px 48px,
			radial-gradient(circle, rgba(255, 250, 240, 0.4) 1.5px, transparent 2px) 20px 26px / 48px 48px,
			radial-gradient(circle, rgba(255, 250, 240, 0.45) 3.5px, transparent 4px) 36px 10px / 96px 48px;
		mask: linear-gradient(to left, #000, transparent 55%);
	}

	.year,
	.tags,
	.meta {
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	.name {
		font-size: clamp(28px, 3.4vw, 48px);
		line-height: 1;
		letter-spacing: -0.03em;
		transition: transform 320ms var(--ease-out-quart);
	}

	/* KartTracker's own logo style (same as its project view, see projects/KartTracker.astro), a little smaller
	   than the other names since the font is much wider. Outline and shadows scale with the size. */
	.brand-karttracker {
		display: flex;
		font-family: var(--font-bowlby-one-sc);
		font-weight: 400;
		font-size: clamp(22px, 2.6vw, 38px);
		letter-spacing: 0;
		white-space: nowrap;
	}

	.brand-karttracker .kart {
		color: #f4a700;
		-webkit-text-stroke: 0.035em #a96800;
		text-shadow:
			0.045em 0.045em 0 #5b2d00,
			0.07em 0.07em 0.14em rgba(0, 0, 0, 0.4);
	}

	.brand-karttracker .tracker {
		color: #cc1100;
		-webkit-text-stroke: 0.035em #7a0000;
		text-shadow:
			0.045em 0.045em 0 #3b0000,
			0.07em 0.07em 0.14em rgba(0, 0, 0, 0.4);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.description {
		font-size: 16px;
		line-height: 1.45;
		opacity: 0.8;
	}

	/* Tags with their tool's logo where there is one (see projects/logos.ts) */
	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 4px 14px;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.tag svg {
		width: 14px;
		height: 14px;
		flex: none;
		fill: currentColor;
	}

	.arrow {
		justify-self: end;
		font-size: 22px;
		opacity: 0.6;
		transition:
			transform 320ms var(--ease-out-quart),
			opacity 220ms var(--ease-out-quart);
	}

	@media (hover: hover) {
		.row:hover::before {
			opacity: 1;
		}

		.row[data-vibe='map']:hover::after {
			transform: scale(1.08);
		}

		.row[data-vibe='race']:hover::after {
			transform: translateX(-32px);
		}

		.row[data-vibe='beer']:hover::after {
			transform: translateY(-48px);
		}

		.row:hover .name {
			transform: translateX(8px);
		}

		.row:hover .arrow {
			opacity: 1;
			transform: translateX(4px);
		}
	}

	.row:focus-visible {
		outline: 2px solid var(--on-accent);
		outline-offset: -6px;
	}

	/* ——— Detail ——— */

	.detail {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* Only the open project is shown (display: flex above would otherwise override [hidden]) */
	.detail[hidden] {
		display: none;
	}

	/* The project's own component takes the full width; the placeholder view stays narrow */
	.detail > :global(:not(.back)) {
		align-self: stretch;
	}

	.generic {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 20px;
		max-width: 64ch;
	}

	/* Stays just under the header while the project scrolls, on a full-width strip in the project's colour
	   (box-shadow + clip-path stretch its background sideways without affecting layout) */
	.back {
		position: sticky;
		/* Sticky offsets count from inside the pane's padding (88px): -34px puts it at 54px, under the header */
		top: -34px;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: -34px 0 clamp(16px, 4vh, 40px);
		padding: 10px 0;
		border: 0;
		background: var(--accent);
		box-shadow: 0 0 0 100vmax var(--accent);
		clip-path: inset(0 -100vmax);
		color: inherit;
		font: inherit;
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.back span {
		transition: transform 220ms var(--ease-out-quart);
	}

	@media (hover: hover) {
		.back:hover span {
			transform: translateX(-4px);
		}
	}

	.back:focus-visible,
	.link:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	.meta {
		margin: 0;
	}

	h3 {
		margin: 0;
		font-size: clamp(40px, 7vw, 112px);
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: -0.04em;
		outline: none;
	}

	.lead {
		margin: 0;
		font-size: 20px;
		line-height: 1.45;
	}

	.placeholder {
		margin: 0;
		font-size: 16px;
		opacity: 0.6;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 28px;
		margin: 8px 0 0;
	}

	.link {
		margin-top: 8px;
		color: inherit;
		font-size: 16px;
		text-underline-offset: 4px;
	}

	@media (max-width: 760px) {
		.projects,
		.projects li {
			display: block;
		}

		.row {
			grid-template-columns: minmax(0, 1fr) 24px;
			gap: 6px 12px;
			padding: 18px 4px;
		}

		.year,
		.description,
		.tags {
			grid-column: 1;
		}

		.name {
			grid-column: 1;
			grid-row: 2;
		}

		.arrow {
			grid-column: 2;
			grid-row: 1 / span 2;
			align-self: center;
		}

		.tags {
			flex-wrap: wrap;
			justify-content: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track,
		#projects[data-detail] .track,
		.row::before,
		.name,
		.arrow {
			transition: none;
		}
	}
</style>

<script>
	const OPEN_MS = 650; // keep in sync with the CSS transitions on .track
	const CLOSE_MS = 520;
	const EASE = 'cubic-bezier(0.77, 0, 0.175, 1)';

	const section = document.querySelector<HTMLElement>('#projects')!;
	const track = section.querySelector<HTMLElement>('.track')!;
	const listPane = section.querySelector<HTMLElement>('.list-pane')!;
	const detailPane = section.querySelector<HTMLElement>('.detail-pane')!;
	const details = [...section.querySelectorAll<HTMLElement>('.detail')];
	const header = document.querySelector<HTMLElement>('.site-header');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const listColor = section.dataset.headerColor!;
	let openSlug: string | null = null;
	let lockTimer = 0;

	// The header takes the colour of the section under it; let it change in step with the slide
	function tintHeader(color: string, ink: string | undefined, duration: number) {
		section.dataset.headerColor = color;
		// The header's text follows the project's text colour, so it stays readable on light colours
		if (ink) section.dataset.headerInk = ink;
		else delete section.dataset.headerInk;
		if (header && duration && !reduceMotion) {
			header.style.transition = `background-color ${duration}ms ${EASE}, color ${duration}ms ${EASE}`;
			setTimeout(() => (header.style.transition = ''), duration);
		}
		window.dispatchEvent(new Event('scroll')); // the header re-reads its colour on scroll
	}

	// Jumps without the slide (first load, restoring from history)
	function withoutTransition(fn: () => void) {
		track.style.transition = 'none';
		fn();
		track.getBoundingClientRect(); // apply the jump before re-enabling the transition
		track.style.transition = '';
	}

	function open(slug: string, animate: boolean) {
		const detail = details.find((d) => d.dataset.project === slug);
		if (!detail) return close(false);
		openSlug = slug;
		for (const d of details) d.hidden = d !== detail;
		detailPane.setAttribute('style', detail.getAttribute('style') ?? '');

		const show = () => section.toggleAttribute('data-detail', true);
		animate ? show() : withoutTransition(show);
		listPane.inert = true;
		detailPane.inert = false;
		tintHeader(detail.dataset.accent!, detail.dataset.onAccent, animate ? OPEN_MS : 0);
		detailPane.scrollTop = 0;

		// Bring the section's top into view while the pane slides in, then lock the page there
		// (so you can't scroll back up into the other sections) and hand focus to the project's title
		const smooth = animate && !reduceMotion;
		section.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
		clearTimeout(lockTimer);
		lockTimer = window.setTimeout(
			() => {
				if (openSlug !== slug) return;
				scrollTo({ top: section.offsetTop, behavior: 'instant' });
				document.documentElement.toggleAttribute('data-scroll-lock', true);
				detail.querySelector<HTMLElement>('[data-detail-title]')?.focus({ preventScroll: true });
			},
			animate ? OPEN_MS : 0,
		);
	}

	function close(animate: boolean) {
		const was = openSlug;
		openSlug = null;
		clearTimeout(lockTimer);
		document.documentElement.removeAttribute('data-scroll-lock');
		if (!section.hasAttribute('data-detail')) return;
		const hide = () => section.removeAttribute('data-detail');
		animate ? hide() : withoutTransition(hide);
		listPane.inert = false;
		detailPane.inert = true;
		tintHeader(listColor, undefined, animate ? CLOSE_MS : 0);
		// Once the slide is done, put the detail away so nothing of it can show next to the list
		setTimeout(() => {
			if (!openSlug) for (const d of details) d.hidden = true;
		}, animate ? CLOSE_MS : 0);
		// Back to the row you came from
		section.querySelector<HTMLElement>(`[data-open="${was}"]`)?.focus({ preventScroll: true });
	}

	// The address is the source of truth: #projects/<slug> shows a project, anything else shows the list
	function sync(animate = true) {
		const match = location.hash.match(/^#projects\/(.+)$/);
		if (match) open(decodeURIComponent(match[1]), animate);
		else close(animate);
	}

	for (const row of section.querySelectorAll<HTMLElement>('[data-open]')) {
		row.addEventListener('click', () => {
			history.pushState({ fromList: true }, '', `#projects/${row.dataset.open}`);
			sync();
		});
	}

	function backToList() {
		// Opened from the list: step back in history (so Back/Forward stay tidy); from a shared link: go to the list
		if (history.state?.fromList) history.back();
		else {
			history.pushState(null, '', '#projects');
			sync();
		}
	}
	for (const back of section.querySelectorAll<HTMLElement>('[data-close]')) back.addEventListener('click', backToList);
	addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && openSlug) backToList();
	});

	addEventListener('popstate', () => sync());
	addEventListener('hashchange', () => sync());
	sync(false);
</script>
