---
// Demo: a miniature project list. A row lights up in its colour and its pane slides in from the right, then
// slides back. Plays by itself; click a row (or "All") to try it.
const rows = [
	{ name: 'Project two', color: 'var(--color-saddle-brown)', ink: '#f4efe1' },
	{ name: 'Project three', color: 'var(--color-dusty-olive)', ink: '#f4efe1' },
	{ name: 'Project four', color: 'var(--color-dry-sage)', ink: 'var(--color-charcoal-brown)' },
];
---

<div class="demo-slide" data-demo-slide aria-hidden="true">
	<div class="track">
		<div class="list">
			<span class="heading">Projects</span>
			{
				rows.map((row, i) => (
					<button
						class="row"
						type="button"
						tabindex="-1"
						data-row={i}
						data-cursor="plain"
						style={`--c: ${row.color}; --ink: ${row.ink}`}
					>
						{row.name}
						<span>→</span>
					</button>
				))
			}
		</div>
		<div class="pane">
			<button class="back" type="button" tabindex="-1" data-back>← All</button>
			<span class="title"></span>
		</div>
	</div>
</div>

<style>
	.demo-slide {
		--ease-in-out-quart: cubic-bezier(0.77, 0, 0.175, 1);
		--ease-out-quart: cubic-bezier(0.165, 0.84, 0.44, 1);

		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: 3px;
		font-family: var(--font-inter-tight);
		font-weight: 600;
		color: #f4efe1;
	}

	.track {
		display: grid;
		grid-template-columns: 100% 100%;
		height: 100%;
		transition: transform 520ms var(--ease-in-out-quart);
	}

	.demo-slide[data-open] .track {
		transform: translateX(-100%);
		transition-duration: 650ms;
	}

	.list,
	.pane {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		padding: 16px 18px;
	}

	.list {
		justify-content: center;
		background: var(--color-projects);
	}

	.heading {
		margin-bottom: 8px;
		font-size: 22px;
		letter-spacing: -0.03em;
	}

	.row {
		position: relative;
		isolation: isolate;
		display: flex;
		justify-content: space-between;
		padding: 9px 8px;
		border: 0;
		border-top: 1px solid rgba(244, 239, 225, 0.2);
		background: none;
		color: inherit;
		font: inherit;
		font-size: 15px;
		text-align: left;
		cursor: pointer;
		transition: color 220ms var(--ease-out-quart);
	}

	.row::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--c);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 320ms var(--ease-out-quart);
	}

	.row:hover,
	.row[data-lit] {
		color: var(--ink);
	}

	.row:hover::before,
	.row[data-lit]::before {
		transform: scaleX(1);
	}

	.pane {
		gap: 10px;
		background: var(--c, var(--color-camel));
		color: var(--ink, #f4efe1);
	}

	.back {
		align-self: flex-start;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 12px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.title {
		margin-top: auto;
		font-size: clamp(26px, 3vw, 40px);
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	@media (prefers-reduced-motion: reduce) {
		.track,
		.row::before {
			transition: none;
		}
	}
</style>

<script>
	const OPEN_MS = 650;
	const HOLD_MS = 1500;
	const IDLE_MS = 1400;

	for (const box of document.querySelectorAll<HTMLElement>('[data-demo-slide]')) {
		const rows = [...box.querySelectorAll<HTMLElement>('[data-row]')];
		const pane = box.querySelector<HTMLElement>('.pane')!;
		const title = box.querySelector<HTMLElement>('.title')!;
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		let visible = false;
		let userUntil = 0; // auto-play waits while you're trying it
		let next = 0;
		const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

		function open(row: HTMLElement) {
			pane.setAttribute('style', row.getAttribute('style') ?? '');
			title.textContent = row.firstChild?.textContent?.trim() ?? '';
			box.toggleAttribute('data-open', true);
		}
		const close = () => box.removeAttribute('data-open');

		for (const row of rows) {
			row.addEventListener('click', () => {
				userUntil = performance.now() + 6000;
				open(row);
			});
		}
		box.querySelector('[data-back]')!.addEventListener('click', () => {
			userUntil = performance.now() + 6000;
			close();
		});

		async function autoplay() {
			while (true) {
				await wait(IDLE_MS);
				if (!visible || reduceMotion || performance.now() < userUntil) continue;
				const row = rows[next++ % rows.length];
				row.toggleAttribute('data-lit', true);
				await wait(450);
				// You may have clicked something meanwhile: then leave it to you
				if (performance.now() < userUntil) {
					row.removeAttribute('data-lit');
					continue;
				}
				open(row);
				await wait(OPEN_MS + HOLD_MS);
				if (performance.now() >= userUntil) close();
				row.removeAttribute('data-lit');
			}
		}

		new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(box);
		autoplay();
	}
</script>
