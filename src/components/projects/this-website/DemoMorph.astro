---
// Demo: a miniature of the scroll transition. The characters of "AJ." break loose, fly into a small character
// portrait, hold, and fly back, on a loop.
import portrait from '../../../assets/asgeir.png';
---

<div class="demo-morph" data-demo-morph data-src={portrait.src} aria-hidden="true"><canvas></canvas></div>

<style>
	.demo-morph {
		position: relative;
		width: 100%;
		height: 100%;
		font-family: var(--font-inter-tight);
		font-weight: 600;
	}

	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	const GLYPHS = 'abcdefghijklmnopqrstuvwxyz0123456789#%&*+=-/<>';
	const RAMP = ' .,:;-=+*x%#@';
	const MAX = 1400;

	// The loop (ms): hold the name, fly to the portrait, hold it, fly back
	const HOLD = 1100;
	const FLY = 1500;
	const CYCLE = (HOLD + FLY) * 2;
	const STAGGER = 0.3; // share of the flight spent staggering left → right

	// --ease-in-out-cubic, like the real transition
	const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
	const clamp = (t: number) => Math.min(1, Math.max(0, t));

	type Grid = { xs: number[]; ys: number[]; chars: string[]; cell: number };

	for (const box of document.querySelectorAll<HTMLElement>('[data-demo-morph]')) {
		const canvas = box.querySelector('canvas')!;
		const ctx = canvas.getContext('2d')!;
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const photo = new Image();
		photo.src = box.dataset.src!;

		let width = 0;
		let height = 0;
		let particles: {
			sx: number; sy: number; tx: number; ty: number;
			from: string; to: string; delay: number; drop: number; scatter: number;
		}[] = [];
		let fromCell = 6;
		let toCell = 5;
		let visible = false;
		let running = false;
		let start = 0;

		// "AJ." as characters inside its letterforms
		function textGrid(): Grid {
			const style = getComputedStyle(box);
			const size = Math.min(height * 0.62, width * 0.36);
			const cell = Math.max(5, Math.round(size / 20));
			const mask = document.createElement('canvas');
			mask.width = width;
			mask.height = height;
			const mctx = mask.getContext('2d', { willReadFrequently: true })!;
			mctx.font = `${style.fontWeight} ${size}px ${style.fontFamily}`;
			mctx.textAlign = 'center';
			mctx.textBaseline = 'middle';
			mctx.fillText('AJ.', width / 2, height / 2);
			const alpha = mctx.getImageData(0, 0, width, height).data;
			const grid: Grid = { xs: [], ys: [], chars: [], cell };
			for (let y = cell / 2; y < height; y += cell) {
				for (let x = cell * 0.3; x < width; x += cell * 0.6) {
					if (alpha[((y | 0) * width + (x | 0)) * 4 + 3] > 100) {
						grid.xs.push(x);
						grid.ys.push(y);
						grid.chars.push(GLYPHS[(Math.random() * GLYPHS.length) | 0]);
					}
				}
			}
			return grid;
		}

		// The portrait as characters: brighter → denser, only inside the cut-out
		function photoGrid(): Grid {
			const cell = 5;
			const cellW = cell * 0.6;
			const fitH = height * 0.95;
			const fitW = (fitH * photo.naturalWidth) / photo.naturalHeight;
			const cols = Math.floor(fitW / cellW);
			const rows = Math.floor(fitH / cell);
			const sample = document.createElement('canvas');
			sample.width = cols;
			sample.height = rows;
			const sctx = sample.getContext('2d', { willReadFrequently: true })!;
			sctx.drawImage(photo, 0, 0, cols, rows);
			const data = sctx.getImageData(0, 0, cols, rows).data;
			const lum = (i: number) => (0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2]) / 255;
			let lo = 1;
			let hi = 0;
			for (let i = 0; i < data.length; i += 4) {
				if (data[i + 3] < 90) continue;
				lo = Math.min(lo, lum(i));
				hi = Math.max(hi, lum(i));
			}
			const left = (width - cols * cellW) / 2;
			const top = (height - rows * cell) / 2;
			const grid: Grid = { xs: [], ys: [], chars: [], cell };
			for (let row = 0; row < rows; row++) {
				for (let col = 0; col < cols; col++) {
					const i = (row * cols + col) * 4;
					if (data[i + 3] < 90) continue;
					const light = clamp((lum(i) - lo) / Math.max(0.05, hi - lo));
					const char = RAMP[Math.round(Math.pow(light, 1.3) * (RAMP.length - 1))];
					if (char === ' ') continue;
					grid.xs.push(left + col * cellW + cellW / 2);
					grid.ys.push(top + row * cell + cell / 2);
					grid.chars.push(char);
				}
			}
			return grid;
		}

		function build() {
			width = box.clientWidth;
			height = box.clientHeight;
			if (!width || !height || !photo.naturalWidth) return;
			const scale = Math.min(devicePixelRatio || 1, 2);
			canvas.width = Math.round(width * scale);
			canvas.height = Math.round(height * scale);
			ctx.setTransform(scale, 0, 0, scale, 0, 0);

			const from = textGrid();
			const to = photoGrid();
			fromCell = from.cell;
			toCell = to.cell;
			// Pair left to right, so each part of the name flows into the matching part of the portrait
			const order = (g: Grid) => g.xs.map((_, i) => i).sort((a, b) => g.xs[a] - g.xs[b] || g.ys[a] - g.ys[b]);
			const fromOrder = order(from);
			const toOrder = order(to);
			const count = Math.min(MAX, to.xs.length);
			particles = Array.from({ length: count }, (_, k) => {
				const s = fromOrder[Math.floor((k * fromOrder.length) / count)];
				const t = toOrder[Math.floor((k * toOrder.length) / count)];
				return {
					sx: from.xs[s], sy: from.ys[s], tx: to.xs[t], ty: to.ys[t],
					from: from.chars[s], to: to.chars[t],
					delay: STAGGER * (from.xs[s] / width) + Math.random() * 0.06,
					drop: 10 + Math.random() * 40,
					scatter: (Math.random() - 0.5) * 50,
				};
			});
			if (!running) draw(performance.now());
		}

		// 0 = name, 1 = portrait, at time t into the loop
		function phase(t: number) {
			if (reduceMotion) return 1;
			const c = t % CYCLE;
			if (c < HOLD) return 0;
			if (c < HOLD + FLY) return (c - HOLD) / FLY;
			if (c < HOLD * 2 + FLY) return 1;
			return 1 - (c - HOLD * 2 - FLY) / FLY;
		}

		function draw(now: number) {
			const p = phase(now - start);
			const ink = getComputedStyle(box).color;
			ctx.clearRect(0, 0, width, height);
			ctx.fillStyle = ink;
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';
			const scramble = Math.floor(now / 70);
			// Three size steps between the name's and the portrait's characters (few canvas state changes)
			for (let step = 0; step < 3; step++) {
				ctx.font = `700 ${(fromCell + ((toCell - fromCell) * (step + 0.5)) / 3) * 1.1}px ui-monospace, "SF Mono", Menlo, Consolas, monospace`;
				for (let i = 0; i < particles.length; i++) {
					const q = particles[i];
					const e = ease(clamp((p - q.delay) / (1 - STAGGER)));
					if (Math.min(2, Math.floor(e * 3)) !== step) continue;
					const arc = Math.sin(Math.PI * e);
					const x = q.sx + (q.tx - q.sx) * e + arc * q.scatter;
					const y = q.sy + (q.ty - q.sy) * e + arc * q.drop;
					const loose = e > 0.1 && e < 0.9;
					ctx.globalAlpha = loose ? 0.55 : 1;
					ctx.fillText(e <= 0.1 ? q.from : e >= 0.9 ? q.to : GLYPHS[(i * 13 + scramble) % GLYPHS.length], x, y);
				}
			}
			ctx.globalAlpha = 1;
			running = visible && !reduceMotion;
			if (running) requestAnimationFrame(draw);
		}

		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			if (visible && !running) {
				start = performance.now();
				running = true;
				requestAnimationFrame(draw);
			}
		}).observe(box);

		let lastWidth = 0;
		new ResizeObserver(() => {
			if (box.clientWidth === lastWidth) return;
			lastWidth = box.clientWidth;
			build();
		}).observe(box);
		Promise.all([photo.decode().catch(() => {}), document.fonts.ready]).then(build);
	}
</script>
