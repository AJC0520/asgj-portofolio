---
// The question as it turns up in a group chat, and the answer. Plays out like a real conversation when it scrolls
// into view: typing dots, then each message pops in; my reply comes last, in iMessage blue.
// Replays each time the project is opened, or with the Replay button. With reduced motion, it simply shows.
const messages = [
	{ from: 'them', text: 'Når stenger egentlig ølsalget?' },
	{ from: 'them', text: 'Er det 18 på lørdag?' },
	{ from: 'me', text: 'nårstengerølsalget.no 🍺' },
];
---

<div class="wrap" data-chat>
	<div class="chat" aria-hidden="true">
		{
			messages.map((message, i) => (
				<p class:list={['msg', message.from, { next: i > 0 && messages[i - 1].from === message.from }]}>
					<span class="dots">
						<span />
						<span />
						<span />
					</span>
					<span class="text">{message.text}</span>
				</p>
			))
		}
	</div>
	<button type="button" class="replay" data-replay data-cursor="plain" hidden>↻ Replay</button>
</div>

<style>
	.wrap {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 10px;
		min-width: 0;
	}

	.chat {
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-self: stretch;
		padding: clamp(20px, 3vw, 32px);
		border-radius: 22px;
		background: #fffaf0;
		box-shadow: 0 18px 40px -18px rgba(80, 40, 0, 0.5);
	}

	.msg {
		max-width: 80%;
		margin: 0;
		padding: 12px 16px;
		border-radius: 20px;
		font-size: clamp(16px, 1.5vw, 19px);
		line-height: 1.3;
		transform-origin: bottom left;
		transition:
			opacity 180ms ease,
			transform 380ms cubic-bezier(0.34, 1.56, 0.64, 1); /* a little overshoot: it pops in */
	}

	.them {
		align-self: flex-start;
		border-bottom-left-radius: 6px;
		background: #ece4d4;
	}

	.them.next {
		margin-top: -4px;
	}

	/* My reply in iMessage blue */
	.me {
		align-self: flex-end;
		margin-top: 10px;
		border-bottom-right-radius: 6px;
		background: #0a84ff;
		color: #fff;
		transform-origin: bottom right;
	}

	/* Before its turn, a message is invisible but keeps its place, so nothing below jumps */
	.msg[data-state='waiting'] {
		opacity: 0;
		transform: scale(0.6);
	}

	/* While someone is typing: the bubble holds three bouncing dots instead of the text */
	.dots {
		display: none;
		gap: 5px;
		align-items: center;
		height: 1.3em;
	}

	.msg[data-state='typing'] .dots {
		display: inline-flex;
	}

	.msg[data-state='typing'] .text {
		display: none;
	}

	.dots span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.4;
		animation: bounce 1s ease-in-out infinite;
	}

	.dots span:nth-child(2) {
		animation-delay: 0.15s;
	}

	.dots span:nth-child(3) {
		animation-delay: 0.3s;
	}

	@keyframes bounce {
		0%,
		60%,
		100% {
			transform: none;
			opacity: 0.4;
		}
		30% {
			transform: translateY(-4px);
			opacity: 0.9;
		}
	}

	.replay {
		padding: 4px 2px;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 13px;
		font-weight: 600;
		opacity: 0.6;
		cursor: pointer;
		transition: opacity 160ms ease;
	}

	@media (hover: hover) {
		.replay:hover {
			opacity: 1;
		}
	}

	.replay:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
		border-radius: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.msg {
			transition: none;
		}
	}
</style>

<script>
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// When each message starts typing and when it is sent (ms from the start)
	const SCRIPT = [
		{ typing: 300, sent: 1500 },
		{ typing: 2000, sent: 2900 },
		{ typing: 3800, sent: 5000 },
	];

	for (const root of document.querySelectorAll<HTMLElement>('[data-chat]')) {
		const messages = [...root.querySelectorAll<HTMLElement>('.msg')];
		const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
		let timers: number[] = [];
		let played = false;

		const set = (message: HTMLElement, state: string) => (message.dataset.state = state);

		function reset() {
			timers.forEach(clearTimeout);
			timers = [];
			messages.forEach((message) => set(message, 'waiting'));
			replay.hidden = true;
		}

		function play() {
			reset();
			messages.forEach((message, i) => {
				timers.push(window.setTimeout(() => set(message, 'typing'), SCRIPT[i].typing));
				timers.push(window.setTimeout(() => set(message, 'sent'), SCRIPT[i].sent));
			});
			timers.push(window.setTimeout(() => (replay.hidden = false), SCRIPT[SCRIPT.length - 1].sent + 600));
		}

		if (reduceMotion || !('IntersectionObserver' in window)) continue; // the messages simply show

		reset();
		replay.addEventListener('click', play);

		// Plays once it is well in view; when the project is closed (the view is hidden), it is ready to play again
		new IntersectionObserver(
			(entries) => {
				const entry = entries[entries.length - 1];
				if (entry.isIntersecting && !played) {
					played = true;
					play();
				} else if (!entry.isIntersecting && root.getClientRects().length === 0) {
					played = false;
					reset();
				}
			},
			{ threshold: 0.6 },
		).observe(root);
	}
</script>
