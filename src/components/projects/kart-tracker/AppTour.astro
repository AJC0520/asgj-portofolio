---
// A tabbed tour of the app's main screens. Each tab swaps in a screenshot placeholder and what the screen does.
// All the content comes from the app's views and utils (LeaderboardView, AddRaceView, stats.ts, TrackMap).
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

// The screens (and an id, so several tours can live on one page) come from the parent.
// A screen with `images` shows those pictures (stacked, each with its own alt text); without, a placeholder.
interface Props {
	id: string;
	screens: Array<{
		id: string;
		name: string;
		title: string;
		text: string;
		points: string[];
		shot: string;
		ratio: string;
		images?: Array<{ src: ImageMetadata; alt: string }>;
	}>;
}

const { id, screens } = Astro.props;
---

<div class="tour" data-tour>
	<div class="tabs" role="tablist" aria-label="App screens" aria-orientation="vertical">
		{
			screens.map((screen, i) => (
				<button
					class="tab"
					type="button"
					role="tab"
					id={`tour-tab-${id}-${screen.id}`}
					aria-controls={`tour-panel-${id}-${screen.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					tabindex={i === 0 ? 0 : -1}
					data-cursor="plain"
				>
					{screen.name}
				</button>
			))
		}
	</div>

	<div class="panels">
		{
			screens.map((screen, i) => (
				<div
					class="panel"
					role="tabpanel"
					id={`tour-panel-${id}-${screen.id}`}
					aria-labelledby={`tour-tab-${id}-${screen.id}`}
					hidden={i !== 0}
				>
					{screen.images ? (
						<div class="shots" data-portrait={screen.images.every((i) => i.src.height > i.src.width) || undefined}>
							{screen.images.map((image) => (
								<Placeholder label={image.alt} image={image.src} />
							))}
						</div>
					) : (
						<Placeholder label={screen.shot} ratio={screen.ratio} />
					)}
					<div class="text">
						<h5>{screen.title}</h5>
						<p>{screen.text}</p>
						<ul>
							{screen.points.map((point) => (
								<li>{point}</li>
							))}
						</ul>
					</div>
				</div>
			))
		}
	</div>
</div>

<style>
	.tour {
		display: grid;
		grid-template-columns: minmax(0, 250px) minmax(0, 1fr);
		gap: 24px clamp(24px, 4vw, 64px);
	}

	/* The list of screens as a game menu, in a sunken panel */
	.tabs {
		display: flex;
		flex-direction: column;
		align-self: start;
		gap: 2px;
		padding: 8px;
		border-radius: 12px;
		background: var(--kt-well);
	}

	.tab {
		position: relative;
		padding: 12px 14px 12px 34px;
		border: 0;
		border-radius: 8px;
		background: none;
		color: inherit;
		font: inherit;
		font-size: clamp(17px, 1.5vw, 20px);
		font-weight: 600;
		letter-spacing: -0.01em;
		text-align: left;
		line-height: 1.2;
		opacity: 0.6;
		cursor: pointer;
		transition:
			opacity 200ms var(--ease-out),
			background-color 200ms var(--ease-out),
			color 200ms var(--ease-out);
	}

	/* The menu cursor: slides in next to the chosen screen and blinks there */
	.tab::before {
		content: '▶';
		position: absolute;
		left: 12px;
		top: 50%;
		font-size: 12px;
		color: var(--kt-gold);
		opacity: 0;
		transform: translate(-6px, -50%);
		transition:
			opacity 200ms var(--ease-out),
			transform 260ms var(--ease-out);
	}

	.tab[aria-selected='true'] {
		opacity: 1;
		background: color-mix(in srgb, var(--kt-gold) 16%, transparent);
		color: var(--kt-gold);
	}

	.tab[aria-selected='true']::before {
		opacity: 1;
		transform: translate(0, -50%);
		animation: cursor-blink 1.1s steps(1) 300ms infinite;
	}

	@keyframes cursor-blink {
		50% {
			opacity: 0.3;
		}
	}

	@media (hover: hover) {
		.tab:hover {
			opacity: 1;
		}
	}

	.tab:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	.shots {
		display: flex;
		flex-direction: column;
		gap: 20px;
		min-width: 0;
	}

	/* Tall screenshots (a side panel, a dialog) stay narrow instead of filling the column */
	.shots[data-portrait] {
		max-width: 420px;
	}

	.panel {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		gap: 24px clamp(24px, 3vw, 48px);
		align-items: center;
	}

	/* display: grid above would otherwise override [hidden] */
	.panel[hidden] {
		display: none;
	}

	.panel:not([hidden]) {
		animation: panel-in 320ms var(--ease-out) both;
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}

	h5 {
		margin: 0 0 10px;
		font-size: clamp(20px, 1.8vw, 26px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.text p {
		margin: 0 0 14px;
		font-size: 15px;
		line-height: 1.55;
		opacity: 0.85;
	}

	ul {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 14px;
	}

	li {
		padding-left: 16px;
		position: relative;
	}

	li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 8px;
		height: 2px;
		background: var(--kt-gold);
	}

	@media (max-width: 900px) {
		.tour,
		.panel {
			grid-template-columns: minmax(0, 1fr);
		}

		/* Tabs become a row you can scroll sideways within, not a page-wide scroll */
		.tabs {
			flex-direction: row;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.tab {
			flex: none;
			white-space: nowrap;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.panel:not([hidden]) {
			animation: none;
		}

		.tab,
		.tab::before {
			transition: none;
		}

		.tab[aria-selected='true']::before {
			animation: none;
		}
	}
</style>

<script>
	for (const tour of document.querySelectorAll<HTMLElement>('[data-tour]')) {
		const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
		const panels = [...tour.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

		function select(index: number, focus = false) {
			tabs.forEach((tab, i) => {
				tab.setAttribute('aria-selected', String(i === index));
				tab.tabIndex = i === index ? 0 : -1;
			});
			panels.forEach((panel, i) => (panel.hidden = i !== index));
			if (focus) tabs[index].focus();
		}

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(i));
			tab.addEventListener('keydown', (e) => {
				const next = {
					ArrowDown: (i + 1) % tabs.length,
					ArrowRight: (i + 1) % tabs.length,
					ArrowUp: (i - 1 + tabs.length) % tabs.length,
					ArrowLeft: (i - 1 + tabs.length) % tabs.length,
					Home: 0,
					End: tabs.length - 1,
				}[e.key];
				if (next === undefined) return;
				e.preventDefault();
				select(next, true);
			});
		});
	}
</script>
