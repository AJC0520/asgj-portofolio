---
// The game's "Select mode" screen: the label is its title, each option a big card, each panel a page of its own.
// Each option's panel is the slot with the option's id; the first option starts selected.
interface Props {
	label: string;
	options: { id: string; label: string; description?: string; icon?: 'trophy' | 'beer' }[];
}

const { label, options } = Astro.props;
const labelId = `switch-${options.map((option) => option.id).join('-')}`;
const panels = await Promise.all(options.map((option) => Astro.slots.render(option.id)));

// 24×24 line icons, drawn in the card's text colour
const icons = {
	trophy: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3',
	beer: 'M5 8h10v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8zM15 10h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2M5 8a2.5 2.5 0 0 1 2-3.5 3 3 0 0 1 5 0A2.5 2.5 0 0 1 15 8M8.5 12v5.5M11.5 12v5.5',
};
---

<div class="switcher" data-switcher>
	<p class="title" id={labelId}>{label}</p>
	<div class="switch" role="group" aria-labelledby={labelId}>
		{
			options.map((option, i) => (
				<button class="card" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-mode={option.id} data-cursor="plain">
					{option.icon && (
						<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
							<path d={icons[option.icon]} />
						</svg>
					)}
					<span class="name">{option.label}</span>
					{option.description && <span class="description">{option.description}</span>}
					<span class="state" aria-hidden="true">
						<span class="selected">▶ Selected</span>
						<span class="choose">Choose</span>
					</span>
				</button>
			))
		}
	</div>

	{
		options.map((option, i) => (
			<div class="panel" data-panel={option.id} hidden={i !== 0}>
				<Fragment set:html={panels[i]} />
			</div>
		))
	}
</div>

<style>
	.switcher {
		display: flex;
		flex-direction: column;
		gap: clamp(36px, 6vh, 64px);
	}

	.switch {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(14px, 2vw, 24px);
		margin-top: -20px; /* sits close under its title */
	}

	.title {
		margin: 0;
		font-family: var(--font-bowlby-one-sc);
		font-size: clamp(28px, 3.4vw, 48px);
		line-height: 1;
		color: var(--kt-gold);
		-webkit-text-stroke: 0.018em var(--kt-gold-edge);
		text-shadow: 0.05em 0.05em 0 #5b2d00;
	}

	.card {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-areas:
			'icon name'
			'icon description'
			'icon state';
		align-items: center;
		gap: 4px 18px;
		padding: clamp(16px, 2vw, 24px);
		border: 2px solid var(--rule);
		border-radius: 14px;
		background: var(--kt-well);
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		box-shadow: 0 0 0 var(--kt-shade);
		transition:
			transform 220ms var(--ease-out),
			box-shadow 220ms var(--ease-out),
			border-color 180ms var(--ease-out),
			background-color 180ms var(--ease-out);
	}

	/* The chosen mode is raised on a hard shadow, like a pressed-out game button */
	.card[aria-pressed='true'] {
		border-color: var(--kt-gold);
		background: color-mix(in srgb, var(--kt-gold) 14%, transparent);
		box-shadow: 0 6px 0 var(--kt-shade);
		transform: translateY(-4px);
	}

	@media (hover: hover) {
		.card[aria-pressed='false']:hover {
			border-color: currentColor;
			box-shadow: 0 3px 0 var(--kt-shade);
			transform: translateY(-2px);
		}
	}

	/* The card rises on hover and sinks when pressed. This invisible margin keeps the pointer on it while it moves,
	   so the hover doesn't flicker at the edges */
	.card::after {
		content: '';
		position: absolute;
		inset: -6px -2px -10px;
	}

	.card:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	.card:active {
		box-shadow: 0 1px 0 var(--kt-shade);
		transform: translateY(1px);
		transition-duration: 80ms;
	}

	.icon {
		grid-area: icon;
		width: clamp(44px, 5vw, 64px);
		height: clamp(44px, 5vw, 64px);
		padding: 10px;
		box-sizing: border-box;
		border-radius: 50%;
		background: color-mix(in srgb, currentColor 10%, transparent);
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			background-color 180ms var(--ease-out),
			color 180ms var(--ease-out);
	}

	.card[aria-pressed='true'] .icon {
		background: var(--kt-gold);
		color: var(--kt-shade);
	}

	.name {
		grid-area: name;
		font-family: var(--font-bowlby-one-sc);
		font-size: clamp(22px, 2.4vw, 32px);
		line-height: 1.05;
	}

	.description {
		grid-area: description;
		font-size: 15px;
		opacity: 0.8;
	}

	.state {
		grid-area: state;
		margin-top: 6px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.selected {
		display: none;
		color: var(--kt-gold);
		animation: blink 1.1s steps(1) infinite;
	}

	.choose {
		opacity: 0.55;
	}

	.card[aria-pressed='true'] .selected {
		display: inline;
	}

	.card[aria-pressed='true'] .choose {
		display: none;
	}

	/* The menu cursor blinks, like the game's */
	@keyframes blink {
		50% {
			opacity: 0.35;
		}
	}

	/* ——— Panels ——— */

	.panel[hidden] {
		display: none;
	}

	.panel:not([hidden]) {
		animation: panel-in 360ms var(--ease-out) both;
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	@media (max-width: 640px) {
		.switch {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.panel:not([hidden]),
		.selected {
			animation: none;
		}

		.card,
		.icon {
			transition: none;
		}
	}
</style>

<script>
	// The pressed option decides which panel is shown
	for (const group of document.querySelectorAll<HTMLElement>('[data-switcher]')) {
		const buttons = [...group.querySelectorAll<HTMLButtonElement>(':scope > .switch [data-mode]')];
		const panels = [...group.querySelectorAll<HTMLElement>(':scope > [data-panel]')];
		for (const button of buttons) {
			button.addEventListener('click', () => {
				for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
				for (const panel of panels) panel.hidden = panel.dataset.panel !== button.dataset.mode;
			});
		}
	}
</script>
