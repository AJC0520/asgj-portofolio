---
// Project view: "Asgard". Rendered inside the project pane in Projects.astro, which provides the colours
// (--accent, --on-accent), the slide, the scroll lock and the "All projects" button.
// The element marked [data-detail-title] receives focus when the view opens.
//
// The page looks like the game: a dark forest green, pixel-art pictures from the game's own sprite sheets, hard-edged
// panels with notched corners, a monospace title. At the top a big way into the town, then what Asgard is, how it is
// set up, and how it is built.
import { CHARACTERS, HOUSE_STYLES } from '../../asgard/config/assets';
import { logoFor, logos } from './logos';
import Sprite from './asgard/Sprite.astro';

interface Props {
	href?: string;
	project: { year: string; tags: string[]; description: string; site?: string; href?: string };
}

const { project } = Astro.props;

const facts: { label: string; value?: string; tools?: string[] }[] = [
	{ label: 'Role', value: 'Design & development' },
	{ label: 'Year', value: project.year },
	{ label: 'Built with', tools: ['Phaser', 'React', 'TypeScript', 'Astro'] },
	{ label: 'Art', value: 'Kenney Tiny Town and Tiny Dungeon (CC0)' },
	{ label: 'Status', value: 'Work in progress' },
];

// The three things a town is made of, each with a picture from the game
const house = { sheet: HOUSE_STYLES['wood-red'].sheet, frame: HOUSE_STYLES['wood-red'].tiles[2][1] };

const parts = [
	{
		title: 'Houses',
		sprite: { sheet: HOUSE_STYLES['wood-red'].sheet, frame: HOUSE_STYLES['wood-red'].tiles[2][1] },
		text: 'Each has a name, a spot on the map, a look to pick from five, and the agent who lives there. Agents walk to the spot just in front of its door.',
	},
	{
		title: 'Agents',
		sprite: CHARACTERS.wizard,
		text: 'A name, a role and a task, a house to start in and one of eleven characters. The role and the task are what you read in the menu.',
	},
	{
		title: 'Schedules',
		sprite: { sheet: 'town' as const, frame: 83 },
		text: 'A list of times, each with a place and an action. The day repeats, and when the town opens everyone is already where their schedule last sent them.',
	},
];

// An agent, as written in src/asgard/config/agents.ts
const example = `{
  id: 'agent-a',
  name: 'Agent A',
  role: 'Collects news from around town',
  task: "Summarising this morning's reports",
  spawn: 'agent-a-house',
  sprite: CHARACTERS.ranger,
  schedule: [
    { time: '07:45', destination: 'mayors-house', action: 'report' },
    { time: '09:00', destinationX: 200, destinationY: 300,
      via: [{ x: 200, y: 180 }], action: 'patrol' },
    { time: '17:00', destination: 'agent-a-house', action: 'rest' },
  ],
}`;

const layers = [
	{ path: 'config/', text: 'The town itself: the map, the houses, the agents and every picture. Content only, no logic.' },
	{ path: 'engine/schedule.ts', text: 'The schedule logic: a clock and an agent in, where it should be heading out. No Phaser, just data.' },
	{ path: 'engine/AsgardScene.ts', text: 'The Phaser scene: builds the map, moves the player and the agents and notices what you stand next to.' },
	{ path: 'engine/bus.ts', text: 'A small typed event bus: how the game tells the menus what is going on, and the other way round.' },
	{ path: 'ui/', text: 'The React screens around the game: the landing page, the clock, the hint and the menu.' },
];
---

<div class="asgard" data-asgard>
	<header class="hero">
		<p class="meta">{project.year} · Work in progress</p>
		<div class="title-row">
			<h3 data-detail-title tabindex="-1">Asgard</h3>
			{
			project.site && (
				<div class="enter">
					<div class="barricade" role="img" aria-label="The town is closed: under construction">
						<Sprite sheet={house.sheet} frame={house.frame} scale={4} />
						<span class="enter-text">
							Under construction
							<small>The town is closed for now.</small>
						</span>
					</div>
				</div>
			)
		}
		</div>
		<p class="lead">
			A small 2D town where AI agents live and work. Each one has a house, a role and a task, and walks around on its
			own daily schedule. It plays in the browser, and you walk around it yourself.
		</p>
	{
		project.href && (
			<p class="links">
				<a class="button" href={project.href} target="_blank" rel="noopener" data-cursor="plain">
					View the code on GitHub <span aria-hidden="true">↗</span>
				</a>
			</p>
		)
	}
	</header>

	<dl class="facts">
		{
			facts.map((fact) => (
				<div>
					<dt>{fact.label}</dt>
					<dd>
						{fact.tools
							? fact.tools.map((tool) => {
									const logo = logoFor(tool);
									return (
										<span class="tool">
											{logo && (
												<svg viewBox="0 0 24 24" aria-hidden="true">
													<path d={logos[logo]} />
												</svg>
											)}
											{tool}
										</span>
									);
								})
							: fact.value}
					</dd>
				</div>
			))
		}
	</dl>

	<section class="block split" data-reveal aria-labelledby="ag-what">
		<div class="copy">
			<h4 id="ag-what">What it is</h4>
			<p class="statement">A town for keeping track of AI agents.</p>
			<p>
				Instead of a list of agents and their status, Asgard gives them somewhere to live. You can see who is at
				home, who is out and where everyone is heading, and you get to know them the way you would in a game: walk
				up and ask.
			</p>
		</div>

		<div class="box">
			<div class="box-in">
				<p class="kicker">Controls</p>
				<ul class="keys">
					<li>
						<span class="cap"><kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd></span>
						<span>or the arrow keys to walk</span>
					</li>
					<li>
						<span class="cap"><kbd>E</kbd></span>
						<span>next to an agent or a house, to see who they are and what they're working on</span>
					</li>
					<li>
						<span class="cap"><kbd>Esc</kbd></span>
						<span>to close the menu</span>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="block" data-reveal aria-labelledby="ag-config">
		<h4 id="ag-config">Everything is config</h4>
		<div class="config">
			<ul class="parts">
				{
					parts.map((part) => (
						<li class="box">
							<div class="box-in part">
								<Sprite sheet={part.sprite.sheet} frame={part.sprite.frame} scale={4} />
								<div>
									<h5>{part.title}</h5>
									<p>{part.text}</p>
								</div>
							</div>
						</li>
					))
				}
			</ul>

			<figure class="code">
				<figcaption>An agent, as written in <code>config/agents.ts</code></figcaption>
				<pre><code>{example}</code></pre>
			</figure>
		</div>
	</section>

	<section class="block" data-reveal aria-labelledby="ag-hood">
		<h4 id="ag-hood">Under the hood</h4>
		<p class="intro">
			Phaser draws the town and React draws everything around it. Both only load on the Asgard page, and Phaser, the
			large one, only downloads when you press Enter the town.
		</p>
		<dl class="layers">
			{
				layers.map((layer) => (
					<div>
						<dt>
							<code>{layer.path}</code>
						</dt>
						<dd>{layer.text}</dd>
					</div>
				))
			}
		</dl>
	</section>


</div>

<style>
	/* The game's own colours, so the page belongs to it */
	.asgard {
		--ag-edge: #0f1a12;
		--ag-panel: #17271d;
		--ag-shade: rgba(0, 0, 0, 0.35);
		--ag-gold: #e3b34c;
		--ag-cream: #f3ecd8;
		--ag-dirt: #b98d57;
		--ag-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
		--rule: color-mix(in srgb, currentColor 25%, transparent);
		--ease-out: cubic-bezier(0.165, 0.84, 0.44, 1);

		display: flex;
		flex-direction: column;
		gap: clamp(40px, 7vh, 72px);
		min-width: 0;
	}

	/* ——— Hero ——— */

	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 18px;
	}

	.meta {
		margin: 0;
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	/* The title, as on the game's own landing page: monospace, with a hard block shadow */
	h3 {
		margin: 0;
		color: var(--ag-gold);
		font-family: var(--ag-mono);
		font-size: clamp(56px, 11vw, 168px);
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.04em;
		text-shadow:
			0.04em 0.04em 0 var(--ag-edge),
			0.07em 0.07em 0 var(--ag-shade);
		outline: none;
	}

	.lead {
		max-width: 46ch;
		margin: 0;
		font-size: clamp(18px, 1.6vw, 22px);
		line-height: 1.45;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin: 6px 0 0;
	}

	/* The way in: the biggest thing on the page, so nobody misses that the town can be visited */
	.enter {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 14px;
		margin-top: 10px;
	}

	/* A barricade across the way in: hazard stripes, and nothing to click */
	.barricade {
		display: inline-flex;
		align-items: center;
		gap: clamp(14px, 2vw, 24px);
		padding: clamp(14px, 2vw, 22px) clamp(20px, 3vw, 36px) clamp(14px, 2vw, 22px) clamp(14px, 2vw, 24px);
		border: 4px solid var(--ag-edge);
		border-radius: 6px;
		background: repeating-linear-gradient(-45deg, var(--ag-gold) 0 18px, #1b1b1b 18px 36px);
		box-shadow:
			0 8px 0 var(--ag-edge),
			0 8px 0 4px var(--ag-edge);
		color: #1b1b1b;
		font-family: var(--ag-mono);
		cursor: not-allowed;
		user-select: none;
	}

	.barricade .enter-text {
		padding: 8px 14px;
		border: 3px solid var(--ag-edge);
		border-radius: 4px;
		background: var(--ag-gold);
	}

	.enter-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: clamp(24px, 3.4vw, 44px);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
		text-align: left;
	}

	.enter-text small {
		max-width: 30ch;
		font-family: var(--font-inter-tight);
		font-size: clamp(13px, 1.1vw, 15px);
		font-weight: 600;
		letter-spacing: 0;
		line-height: 1.3;
		opacity: 0.75;
	}

	.enter-arrow {
		font-size: clamp(30px, 4vw, 52px);
		font-weight: 800;
		line-height: 1;
		transition: transform 200ms var(--ease-out);
	}

	@media (hover: hover) {
		.enter-button:hover {
			transform: translateY(-3px);
			box-shadow:
				0 11px 0 var(--ag-edge),
				0 11px 0 4px var(--ag-edge);
		}

		.enter-button:hover .enter-arrow {
			transform: translateX(8px);
		}
	}

	.enter-button:active {
		transform: translateY(5px);
		box-shadow:
			0 3px 0 var(--ag-edge),
			0 3px 0 4px var(--ag-edge);
	}

	.enter-button:focus-visible {
		outline: 3px solid var(--ag-cream);
		outline-offset: 6px;
	}

	.keys-hint {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 6px;
		margin: 6px 0 0;
		font-size: 13px;
		letter-spacing: 0.04em;
		opacity: 0.8;
	}

	/* The title with the way in beside it: on a wide screen the button sits in the space to the right of the name */
	.title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px clamp(24px, 4vw, 64px);
		width: 100%;
	}

	.title-row .enter {
		margin: 0 4px 0 0; /* room for the button's outer edge */
		align-items: flex-start;
	}

	/* Buttons like the game's: square, a hard shadow that the button sinks into when pressed */
	.button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 11px 18px;
		border: 2px solid var(--ag-edge);
		background: var(--ag-panel);
		box-shadow: 0 4px 0 var(--ag-edge);
		color: var(--ag-cream);
		font-family: var(--ag-mono);
		font-size: 14px;
		font-weight: 700;
		text-decoration: none;
		white-space: nowrap;
		transition:
			transform 120ms var(--ease-out),
			box-shadow 120ms var(--ease-out),
			background-color 160ms var(--ease-out);
	}

	.button.primary {
		background: var(--ag-gold);
		color: #1b1b1b;
	}

	@media (hover: hover) {
		.button:hover {
			transform: translateY(-2px);
			box-shadow: 0 6px 0 var(--ag-edge);
		}
	}

	.button:active {
		transform: translateY(3px);
		box-shadow: 0 1px 0 var(--ag-edge);
	}

	.button:focus-visible {
		outline: 2px solid var(--ag-cream);
		outline-offset: 4px;
	}

	/* ——— Facts ——— */

	.facts {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0 clamp(16px, 2.4vw, 40px);
		margin: 0;
		border-top: 2px dashed var(--rule);
	}

	.facts div {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 14px 0;
		border-bottom: 2px dashed var(--rule);
	}

	dt {
		font-size: 12px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	dd {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
		margin: 0;
		font-size: 15px;
		line-height: 1.35;
	}

	.tool {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.tool svg {
		width: 14px;
		height: 14px;
		flex: none;
		fill: currentColor;
	}

	/* ——— Sections ——— */

	.block {
		display: flex;
		flex-direction: column;
		gap: 22px;
		min-width: 0;
	}

	/* A section's heading, like a menu entry in the game */
	h4 {
		margin: 0;
		color: var(--ag-gold);
		font-family: var(--ag-mono);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h4::before {
		content: '▸ ';
	}

	h5 {
		margin: 0 0 6px;
		font-family: var(--ag-mono);
		font-size: 18px;
		font-weight: 700;
	}

	.split {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: 24px clamp(32px, 5vw, 80px);
		align-items: center;
	}

	.copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.copy p,
	.intro {
		margin: 0;
		max-width: 54ch;
		font-size: 16px;
		line-height: 1.6;
		opacity: 0.9;
	}

	.copy .statement {
		font-size: clamp(26px, 3vw, 44px);
		line-height: 1.05;
		letter-spacing: -0.03em;
		opacity: 1;
	}

	/* A panel with notched corners, like the game's dialogue boxes: an edge, then the dark inside */
	.box {
		--n: 4px;
		padding: 4px;
		background: var(--ag-gold);
		clip-path: polygon(
			var(--n) 0,
			calc(100% - var(--n)) 0,
			calc(100% - var(--n)) var(--n),
			100% var(--n),
			100% calc(100% - var(--n)),
			calc(100% - var(--n)) calc(100% - var(--n)),
			calc(100% - var(--n)) 100%,
			var(--n) 100%,
			var(--n) calc(100% - var(--n)),
			0 calc(100% - var(--n)),
			0 var(--n),
			var(--n) var(--n)
		);
	}

	.box-in {
		padding: 18px 20px;
		background: var(--ag-panel);
		color: var(--ag-cream);
		clip-path: polygon(
			3px 0,
			calc(100% - 3px) 0,
			calc(100% - 3px) 3px,
			100% 3px,
			100% calc(100% - 3px),
			calc(100% - 3px) calc(100% - 3px),
			calc(100% - 3px) 100%,
			3px 100%,
			3px calc(100% - 3px),
			0 calc(100% - 3px),
			0 3px,
			3px 3px
		);
	}

	.kicker {
		margin: 0 0 12px;
		color: var(--ag-gold);
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.keys {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.keys li {
		display: grid;
		grid-template-columns: 168px minmax(0, 1fr);
		align-items: center;
		gap: 12px;
		font-size: 14px;
		line-height: 1.35;
	}

	.cap {
		display: flex;
		gap: 3px;
	}

	kbd {
		display: inline-grid;
		min-width: 22px;
		padding: 3px 6px;
		place-items: center;
		border: 2px solid var(--ag-cream);
		border-radius: 3px;
		box-shadow: 0 2px 0 var(--ag-edge);
		font-family: var(--ag-mono);
		font-size: 12px;
		font-weight: 700;
	}

	/* ——— Config ——— */

	.config {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 24px clamp(24px, 4vw, 56px);
		align-items: start;
	}

	.parts {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.part {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 18px;
		align-items: center;
	}

	.part p {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		opacity: 0.85;
	}

	.code {
		margin: 0;
		min-width: 0;
	}

	.code figcaption {
		margin-bottom: 8px;
		font-size: 12px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	pre {
		margin: 0;
		padding: 16px;
		border: 2px solid var(--ag-edge);
		background: var(--ag-edge);
		color: var(--ag-cream);
		overflow-x: auto;
		scrollbar-width: thin;
	}

	code {
		font-family: var(--ag-mono);
		font-size: 12.5px;
		line-height: 1.6;
	}

	/* ——— Under the hood ——— */

	.layers {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0 clamp(16px, 2.4vw, 36px);
		margin: 0;
	}

	.layers div {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 14px 0;
		border-top: 2px dashed var(--rule);
	}

	.layers dt {
		opacity: 1;
		letter-spacing: 0;
		text-transform: none;
	}

	.layers dt code {
		color: var(--ag-gold);
		font-size: 13px;
		overflow-wrap: anywhere;
	}

	.layers dd {
		font-size: 14px;
		line-height: 1.5;
		opacity: 0.85;
	}

	/* ——— Closing note ——— */

	.note {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 18px 32px;
	}

	.note > div {
		flex: 1 1 320px;
	}

	.note h4 {
		margin-bottom: 8px;
	}

	.note p {
		margin: 0;
		max-width: 60ch;
		font-size: 15px;
		line-height: 1.55;
		opacity: 0.9;
	}

	/* ——— Arriving: sections fade up as they scroll into view (only once the script has armed it) ——— */

	[data-reveal-armed] [data-reveal]:not([data-in]) {
		opacity: 0;
		transform: translateY(18px);
	}

	[data-reveal-armed] [data-reveal] {
		transition:
			opacity 520ms var(--ease-out),
			transform 520ms var(--ease-out);
	}

	@media (max-width: 1100px) {
		.facts,
		.layers {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 900px) {
		.split,
		.config {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 560px) {
		.facts,
		.layers {
			grid-template-columns: minmax(0, 1fr);
		}

		.keys li {
			grid-template-columns: minmax(0, 1fr);
			gap: 6px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.button,
		.enter-button,
		.enter-arrow {
			transition: none;
		}
	}
</style>

<script>
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const root of document.querySelectorAll<HTMLElement>('[data-asgard]')) {
		// Sections ease in as they come into view. Skipped entirely when motion is reduced.
		if (reduceMotion || !('IntersectionObserver' in window)) continue;
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.setAttribute('data-in', '');
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.12 },
		);
		root.setAttribute('data-reveal-armed', '');
		root.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
	}
</script>
