---
// Project view: "This website". Rendered inside the project pane in Projects.astro, which provides the colours
// (--accent, --on-accent), the slide, the scroll lock and the "All projects" button.
// The element marked [data-detail-title] receives focus when the view opens.

import { type Logo, logos } from './logos';
import DemoMap from './this-website/DemoMap.astro';
import DemoMorph from './this-website/DemoMorph.astro';
import DemoName from './this-website/DemoName.astro';
import DemoNav from './this-website/DemoNav.astro';

interface Props {
	href?: string;
}

const { href } = Astro.props;

const facts = [
	{ label: 'Role', value: 'Design & development' },
	{ label: 'Year', value: '2026' },
	{
		label: 'Built with',
		// A list of tools gets each tool's logo (see ./logos.ts)
		value: [
			{ name: 'Astro', logo: 'astro' },
			{ name: 'TypeScript', logo: 'typescript' },
			{ name: 'Canvas', logo: 'html5' },
			{ name: 'SVG', logo: 'svg' },
		] as { name: string; logo?: Logo }[],
	},
	{ label: 'Data', value: 'OpenStreetMap, GitHub API' },
	{ label: 'Made with', value: 'Claude Opus 5.5 in Claude Code' },
];

// Skills: packaged instructions that give the model expert guidance for one kind of task
// To add a skill: add an entry. `command` is how it's invoked; `usedFor` is optional.
const skills = [
	{
		command: 'mcpmarket-me:motion-design',
		name: 'Motion design',
		text: 'Easing curves, durations and, just as often, when not to animate.',
		usedFor: ['Name intro', 'Section transitions', 'Navigation arrow', 'Project slides'],
	},
	{
		command: 'anthropic-skills:hallmark',
		name: 'Hallmark',
		text: 'A design skill aimed at avoiding the generic "AI-made" look.',
		usedFor: ['Layout', 'Background details'],
	},
	{
		command: 'mcpmarket-me:web-performance-optimization',
		name: 'Web performance',
		text: 'Load times, lazy loading, caching and Core Web Vitals: keeping a page this animated quick to load.',
		usedFor: ['Performance'],
	},
];

const features = [
	{
		title: 'A name made of characters',
		text: 'The name in the hero is drawn on a canvas as thousands of small characters, clipped to the letterforms. They scramble in from the left, flicker now and then, and scatter around your cursor.',
		demo: DemoName,
		hint: 'Move your cursor over it',
	},
	{
		title: 'Tromsø at night',
		text: 'The background is a street map of Tromsø built from OpenStreetMap data. A small light drives one of the pre-computed routes through the streets every few seconds.',
		demo: DemoMap,
		hint: 'Tromsø city centre',
	},
	{
		title: 'From name to portrait',
		text: "Scroll down and the name's characters break loose, drift down and land as a portrait of me in the same style. Push them around with your cursor and they spring back.",
		demo: DemoMorph,
		hint: 'The scroll transition, in miniature',
	},
	{
		title: 'Navigation that points',
		text: 'The underline under the current section folds into an arrow pointing at whatever you hover.',
		demo: DemoNav,
		hint: 'Hover the items',
	},
];

// Smaller touches, shown as their own block (no demo needed)
const details = [
	{
		title: 'Activity easter egg',
		text: 'Hover the GitHub icon in the header and my real contribution calendar appears, fetched when the site builds.',
	},
	{
		title: 'A trailing cursor',
		text: 'A small dot follows the cursor with a slight delay.',
	},
	{
		title: 'Calm when asked',
		text: 'Every animation respects the reduced-motion setting: transitions jump straight to their end, and nothing loops.',
	},
];

---

<div class="this-website">
	<header class="intro">
		<p class="kicker">2026 · Personal project</p>
		<h3 data-detail-title tabindex="-1">This website</h3>
		<p class="lead">
			A portfolio where every part tries to feel alive without getting in the way. It's also an experiment: I
			made the whole site together with Claude Opus 5.5 in Claude Code, using skills to steer the design and the
			motion.
		</p>
	</header>

	<dl class="facts">
		{
			facts.map((fact) => (
				<div>
					<dt>{fact.label}</dt>
					<dd>
						{typeof fact.value === 'string' ? (
							fact.value
						) : (
							<ul class="tools">
								{fact.value.map((tool) => (
									<li>
										{tool.logo && (
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d={logos[tool.logo]} />
											</svg>
										)}
										{tool.name}
									</li>
								))}
							</ul>
						)}
					</dd>
				</div>
			))
		}
	</dl>

	<section class="features" aria-labelledby="this-website-features">
		<h4 id="this-website-features">What's in it</h4>
		<ul>
			{
				features.map((feature) => (
					<li class:list={['feature', feature.demo && 'has-demo']}>
						<div class="feature-text">
							<h5>{feature.title}</h5>
							<p>{feature.text}</p>
						</div>
						{feature.demo && (
							<figure class="demo">
								<div class="demo-frame">
									<feature.demo />
								</div>
								<figcaption>{feature.hint}</figcaption>
							</figure>
						)}
					</li>
				))
			}
		</ul>
	</section>

	<section class="details" aria-labelledby="this-website-details">
		<h4 id="this-website-details">Small details</h4>
		<ul>
			{
				details.map((detail) => (
					<li>
						<h5>{detail.title}</h5>
						<p>{detail.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="process" aria-labelledby="this-website-process">
		<!-- Left: the idea in one big line, and how it went -->
		<div class="process-intro">
			<h4 id="this-website-process">How it was made</h4>
			<p class="statement">Built in conversation with Claude Opus 5.5, steered by skills.</p>
			<p>
				This site started as a way to test Claude Opus 5.5 in Claude Code with skills: packaged instructions
				that give the model expert guidance for one kind of task. I described what I wanted in plain words,
				sometimes with a quick sketch, and built it up one change at a time.
			</p>
		</div>

		<!-- Right: the skills, one row each -->
		<div class="skills">
			<p class="skills-count">{skills.length} skills</p>
			<ol>
				{
					skills.map((skill) => (
						<li>
							<div>
								<code>/{skill.command}</code>
								<h5>{skill.name}</h5>
								<p>{skill.text}</p>
								{skill.usedFor && (
									<ul class="used-for" aria-label="Used for">
										{skill.usedFor.map((use) => (
											<li>{use}</li>
										))}
									</ul>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<!-- Across: the experience, as a pull quote -->
		<blockquote class="experience">
			<p>
				What stood out was how fast an idea became something running, and that it checked its own work with
				screenshots and frame-time measurements instead of just claiming it was done.
			</p>
			<p>
				The feel of things took the most rounds: transitions only got smooth after measuring, fixing and trying
				again, and some ideas got scrapped along the way, like a card-deck scroll and a camera that followed a
				car through the map.
			</p>
		</blockquote>
	</section>

	{
		href && (
			<a class="code" href={href} target="_blank" rel="noopener">
				View the code on GitHub <span aria-hidden="true">↗</span>
			</a>
		)
	}
</div>

<style>
	.this-website {
		--rule: color-mix(in srgb, currentColor 25%, transparent);

		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: clamp(32px, 5vh, 56px) clamp(32px, 6vw, 96px);
		align-items: end;
	}

	/* ——— Intro + facts ——— */

	.intro {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.kicker,
	dt,
	h4 {
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.kicker {
		margin: 0;
		opacity: 0.65;
	}

	h3 {
		margin: 0;
		font-size: clamp(48px, 9vw, 144px);
		font-weight: 600;
		line-height: 0.92;
		letter-spacing: -0.045em;
		outline: none;
	}

	.lead {
		max-width: 46ch;
		margin: 0;
		font-size: clamp(18px, 1.6vw, 22px);
		line-height: 1.45;
	}

	.facts {
		display: grid;
		gap: 0;
		margin: 0;
		border-top: 1px solid var(--rule);
	}

	.facts div {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		gap: 16px;
		padding: 12px 0;
		border-bottom: 1px solid var(--rule);
	}

	dt {
		opacity: 0.65;
	}

	dd {
		margin: 0;
		font-size: 16px;
	}

	/* Tools with their logos, flowing like a comma list */
	.tools {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tools li {
		display: inline-flex;
		align-items: center;
		gap: 7px;
	}

	.tools svg {
		width: 16px;
		height: 16px;
		flex: none;
		fill: currentColor;
	}

	/* ——— Features ——— */

	.features {
		grid-column: 1 / -1;
	}

	h4 {
		margin: 0 0 20px;
		opacity: 0.65;
		font-weight: 600;
	}

	.features ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Each feature is a row: the text, and a live demo next to it where one makes sense */
	.feature {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
		gap: 24px clamp(24px, 4vw, 64px);
		align-items: center;
		padding: 28px 0;
		border-top: 1px solid var(--rule);
	}

	.feature:not(.has-demo) .feature-text {
		max-width: 52ch;
	}

	.demo {
		margin: 0;
	}

	.demo-frame {
		position: relative;
		height: clamp(200px, 26vh, 260px);
		border: 1px solid var(--rule);
		border-radius: 4px;
		background: color-mix(in srgb, currentColor 6%, transparent);
		overflow: hidden;
	}

	/* Below the demo, so it stays readable whatever the demo shows */
	figcaption {
		margin-top: 8px;
		font-size: 12px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	/* ——— Small details ——— */

	.details {
		grid-column: 1 / -1;
		padding-top: 28px;
		border-top: 1px solid var(--rule);
	}

	.details ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px clamp(24px, 3vw, 48px);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.details p {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
		opacity: 0.85;
	}

	/* ——— How it was made ——— */

	/* Two columns (intro | skills), then the experience quote across the full width */
	.process {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		gap: 40px clamp(32px, 6vw, 96px);
		padding-top: 28px;
		border-top: 1px solid var(--rule);
	}

	.process-intro {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.process-intro h4 {
		margin: 0;
	}

	.statement {
		margin: 0;
		font-size: clamp(30px, 3.4vw, 52px);
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.process-intro > p:not(.statement) {
		max-width: 46ch;
		margin: 0;
		font-size: 16px;
		line-height: 1.6;
		opacity: 0.85;
	}

	.skills-count {
		margin: 0 0 4px;
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	.skills ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.skills ol > li {
		padding: 20px 0;
		border-bottom: 1px solid var(--rule);
	}

	.skills ol > li:first-child {
		border-top: 1px solid var(--rule);
	}

	code {
		display: block;
		margin-bottom: 6px;
		font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
		font-size: 13px;
		opacity: 0.65;
		overflow-wrap: anywhere;
	}

	.skills ol > li p {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
		opacity: 0.85;
	}

	.used-for {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.used-for li {
		padding: 4px 9px;
		border: 1px solid var(--rule);
		border-radius: 999px;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.experience {
		grid-column: 1 / -1;
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px clamp(24px, 4vw, 64px);
		margin: 0;
		padding: 32px 0 0 clamp(40px, 5vw, 80px);
		border-top: 1px solid var(--rule);
	}

	/* A big opening quote mark hanging in the margin */
	.experience::before {
		content: '“';
		position: absolute;
		left: 0;
		top: 18px;
		font-size: clamp(64px, 7vw, 112px);
		line-height: 1;
		opacity: 0.35;
	}

	.experience p {
		margin: 0;
		font-size: clamp(17px, 1.4vw, 20px);
		line-height: 1.55;
	}

	h5 {
		margin: 0 0 10px;
		font-size: clamp(20px, 1.8vw, 26px);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.features p {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
		opacity: 0.85;
	}

	/* ——— Link ——— */

	.code {
		grid-column: 1 / -1;
		justify-self: start;
		color: inherit;
		font-size: 18px;
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-thickness: 1px;
	}

	.code span {
		display: inline-block;
		transition: transform 220ms cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	@media (hover: hover) {
		.code:hover span {
			transform: translate(3px, -3px);
		}
	}

	.code:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.this-website {
			grid-template-columns: minmax(0, 1fr);
		}

		.feature,
		.process {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (max-width: 560px) {
		.details ul {
			grid-template-columns: minmax(0, 1fr);
		}

		.experience {
			grid-template-columns: minmax(0, 1fr);
		}

		.facts div {
			grid-template-columns: 96px minmax(0, 1fr);
		}
	}
</style>
