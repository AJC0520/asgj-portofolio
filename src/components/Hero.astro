---
import Name from './Name.astro';
---

<section id="hero">
	<div class="scroll-cue" aria-hidden="true">
		<span>Scroll to read more about me</span>
		<span class="track"><span class="pulse"></span></span>
	</div>
	<Name />
</section>

<style>
	#hero {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 24px;
		padding: 0 16px 16px;
		box-sizing: border-box;
	}

	.scroll-cue {
		align-self: flex-end;
		margin-right: clamp(0px, 6vw, 120px);
		display: flex;
		align-items: center;
		gap: 14px;
		font-family: 'Inter Tight', 'Helvetica Neue', Arial, sans-serif;
		font-size: 16px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #e9c85b;
		/* Exit: fast, ease-out */
		transition: opacity 180ms cubic-bezier(0.165, 0.84, 0.44, 1);
	}

	:global([data-scrolled]) .scroll-cue {
		opacity: 0;
	}

	.track {
		position: relative;
		width: 1px;
		height: 56px;
		overflow: hidden;
		background: rgba(233, 200, 91, 0.25);
	}

	/* A short segment travels down the line: "keep going this way" */
	.pulse {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 40%;
		background: #e9c85b;
		animation: travel 1600ms cubic-bezier(0.645, 0.045, 0.355, 1) infinite;
	}

	@keyframes travel {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(250%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse {
			animation: none;
			transform: translateY(75%);
		}
	}
</style>

<script>
	const update = () => document.documentElement.toggleAttribute('data-scrolled', window.scrollY > 8);
	window.addEventListener('scroll', update, { passive: true });
	update();
</script>
