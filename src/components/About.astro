---
import CharHeading from './CharHeading.astro';
---

<section id="about" data-header-color="var(--color-about)">
	<CharHeading text="About" look="solid" />
	<p class="body">
		Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis
		dapibus. Maecenas faucibus mollis interdum. Cras mattis consectetur purus sit amet fermentum.
		Donec ullamcorper nulla non metus auctor fringilla.
	</p>
</section>

<style>
	#about {
		min-height: 100dvh;
		box-sizing: border-box;
		/* Content sits high in the section: the heading is already on screen while the name's characters
		   drift in to form it (see NameMorph.astro) */
		padding: 88px 16px 16px; /* just below the fixed site header */
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 24px;
		background: var(--color-about);
		color: #f4efe1;
		font-family: var(--font-inter-tight);
	}


	/* Sizes the character heading (CharHeading draws its text at this font, size and width) */
	#about :global(.char-heading) {
		margin: 0;
		max-width: 14ch;
		font-size: clamp(40px, 7vw, 112px);
		font-weight: 600;
		line-height: 0.95;
		letter-spacing: -0.04em;
	}

	.body {
		margin: 0;
		max-width: 52ch;
		font-size: 18px;
		line-height: 1.5;
		opacity: 0.85;
	}
</style>
